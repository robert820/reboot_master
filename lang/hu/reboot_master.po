msgstr "\n[Futtatás] Teszt üzemmód engedélyezése...\n"

msgid "[成功] 測試模式已開啟，請重新開機以生效。桌面右下角將顯示「測試模式」浮水印。\n"
msgstr "[OK] Teszt üzemmód engedélyezve. Indítsa újra a gépet az érvényesítéshez.\n"

msgid "[錯誤] {}\n提示：請先到 BIOS 關閉 Secure Boot 後再嘗試。\n"
msgstr "[Hiba] {}\nTipp: Kapcsolja ki a Secure Boot funkciót a BIOS-ban, majd próbálja újra.\n"

msgid "\n[執行] 正在關閉測試模式...\n"
msgstr "\n[Futtatás] Teszt üzemmód letiltása...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[OK] Teszt üzemmód letiltva. Indítsa újra a gépet.\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[Futtatás] Aláírás-kikényszerítés letiltása (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已停用，請重新開機以生效。\n"
msgstr "[OK] Az aláírás-kikényszerítés letiltva. Indítsa újra a gépet.\n"

msgid "[錯誤] {}\n提示：請確認是否具備系統管理員權限，或先到 BIOS 關閉 Secure Boot。\n"
msgstr "[Hiba] {}\nTipp: Ellenőrizze a rendszergazdai jogokat, vagy kapcsolja ki a Secure Boot-ot a BIOS-ban.\n"

msgid "\n[執行] 正在恢復強制簽章 (nointegritychecks)...\n"
msgstr "\n[Futtatás] Aláírás-kikényszerítés visszaállítása (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已恢復正常，請重新開機以生效。\n"
msgstr "[OK] Aláírás-kikényszerítés visszaállítva. Indítsa újra a gépet.\n"

msgid "\n[執行] 正在恢復系統安全防護...\n"
msgstr "\n[Futtatás] Rendszerbiztonság visszaállítása...\n"

msgid "  [錯誤] 關閉 nointegritychecks 失敗: {}\n"
msgstr "  [Hiba] A nointegritychecks kikapcsolása sikertelen: {}\n"

msgid "  - 驅動強制簽章已恢復\n"
msgstr "  - Illesztőprogram-aláírás kikényszerítése visszaállítva\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [Hiba] A testsigning kikapcsolása sikertelen: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [Hiba] Beállításjegyzék-írási hiba (kód: {}): Nem sikerült engedélyezni a memória-integritást\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - Memória-integritás engedélyezve\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - Teszt üzemmód letiltva\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - Rendszerbiztonság visszaállítva\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Hiba] Beállításjegyzék-írási hiba (hibakód: {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Figyelem] Hibák történtek. Kérjük, ellenőrizze a fenti naplót.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[OK] Biztonsági védelem visszaállítva. Indítsa újra a gépet.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Futtatás] Illesztőprogram- és kernelkorlátok feloldása...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Hiba] A nointegritychecks bekapcsolása sikertelen: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Illesztőprogram-aláírás kikényszerítése letiltva\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Hiba] Beállításjegyzék-írási hiba (kód: {}): Nem sikerült letiltani a memória-integritást\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Memória-integritás letiltva\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Hiba] A testsigning bekapcsolása sikertelen: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Teszt üzemmód engedélyezve\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Illesztőprogram-tiltólista letiltva\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[OK] A kijelölt biztonsági korlátozások feloldva. Indítsa újra a gépet.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "Új USB-meghajtó/lemez csatlakoztatva: {} {}"

msgid "移除了隨身碟/磁碟: {} {}"
msgstr "USB-meghajtó/lemez eltávolítva: {} {}"

msgid "未偵測到包含 PE 環境的隨身碟"
msgstr "Nem található PE környezetet tartalmazó USB-meghajtó"

msgid "未插入任何隨身碟"
msgstr "Nincs csatlakoztatva USB-meghajtó"

