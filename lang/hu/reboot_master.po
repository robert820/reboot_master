msgid "\n[執行] 正在請求重啟進入進階選單...\n"
msgstr "\n[Futtatás] Újraindítás kérése a Speciális indítási menübe...\n"

msgid "\n[執行] 正在偵測隨身碟並設定重啟進入 PE...\n"
msgstr "\n[Futtatás] USB-meghajtó észlelése és PE rendszerindítás konfigurálása...\n"

