msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Művelet: {}\n  Részletek: {}\n  Állapot: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Még nincs előzménynapló.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Nem sikerült megszerezni a SeShutdownPrivilege rendszerjogosultságot"

msgid "關機失敗，錯誤碼: {}"
msgstr "Leállítás sikertelen, hibakód: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Nem sikerült megszerezni a SeShutdownPrivilege újraindítási jogosultságot"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Újraindítás sikertelen, hibakód: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "A SeSystemEnvironmentPrivilege nem szerezhető meg. Kérjük, futtassa rendszergazdaként"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Az alaplap vagy az operációs rendszer nem támogatja a közvetlen újraindítást a BIOS-ba"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Nem sikerült írni az UEFI változót. Vírusirtó vagy engedélykorlátozás okozhatja."

msgid "重啟至 BIOS/UEFI"
msgstr "Újraindítás a BIOS/UEFI-be"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "UEFI változó beírva: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), 0. bit 1-re állítva (BootToFwUI)"

msgid "準備重啟"
msgstr "Felkészülés az újraindításra"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Az UEFI változó sikeresen beírva. Újraindítás a BIOS/UEFI-be..."

msgid "執行 bcdedit 失敗: {}"
msgstr "A bcdedit futtatása sikertelen: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "A `bcdedit {}` sikertelen: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "A fizikai rendszer SOFTWARE beállításjegyzék-struktúrája nem található"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Nem található az új GUID kezdete a bcdedit kimenetében"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Nem található az új GUID vége a bcdedit kimenetében"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Az aktuális végrehajtható fájl elérési útja nem érhető el: {}"

msgid "一次性安全模式"
msgstr "Egyszeri csökkentett mód"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Mód: {}\n  Ideiglenes GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Az egyszeri csökkentett mód sikeresen beállítva. Újraindítás..."

msgid "重啟至進階開機選單"
msgstr "Újraindítás a Speciális indításhoz"

msgid "建立臨時副本 GUID: {}"
msgstr "Ideiglenes bejegyzés GUID létrehozva: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Egyszeri speciális indítási beállítások beállítva. Újraindítás..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Újraindítás a BIOS / UEFI firmware-be"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Azonnal újraindítja a számítógépet, és belép a BIOS/UEFI beállításaiba."

msgid "一次性安全模式 (Minimal)"
msgstr "Egyszeri csökkentett mód (minimális)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "A következő indításkor csökkentett módba lép. A következő újraindításkor visszaáll normál módba."

msgid "一次性安全模式 (含網路)"
msgstr "Egyszeri csökkentett mód (hálózattal)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "A következő indításkor hálózattal támogatott csökkentett módba lép. Később visszaáll normál módba."

msgid "重啟進入進階開機選單"
msgstr "Újraindítás a Speciális indítási beállításokhoz"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Újraindítja a gépet, és megnyitja a Windows speciális indítási és hibaelhárítási menüjét."

msgid "直接強制重啟電腦"
msgstr "Kényszerített újraindítás most"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Azonnal újraindítja a számítógépet a natív Win32 API segítségével."

msgid "直接安全關機"
msgstr "Biztonságos leállítás most"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Azonnal kikapcsolja a számítógépet a natív Win32 API segítségével."

msgid "開啟測試模式 (Test Mode)"
msgstr "Teszt üzemmód engedélyezése"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "A rendszer elfogadja a teszt-aláírt illesztőprogramokat. \"Teszt üzemmód\" vízjel jelenik meg.\n\n• A Secure Boot funkciót először ki kell kapcsolni a BIOS-ban\n• A legtöbb csalás elleni rendszer (EAC, BattlEye) blokkolja a játékokat ebben a módban\n• Újraindítás szükséges. Kikapcsoláshoz használja a \"Teszt üzemmód letiltása\" gombot"

msgid "關閉測試模式"
msgstr "Teszt üzemmód letiltása"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "A teszt üzemmód letiltása visszaállítja a normál illesztőprogram-aláírás ellenőrzést. Újraindítás szükséges."

msgid "停用驅動程式強制簽章"
msgstr "Illesztőprogram-aláírás kikényszerítésének letiltása"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Teljesen kikapcsolja a Windows illesztőprogram-aláírás ellenőrzését (nointegritychecks).\n\n• Lehetővé teszi aláíratlan illesztőprogramok telepítését\n• A rendszer biztonsága jelentősen csökken\n• A Secure Boot-ot először ki kell kapcsolni a BIOS-ban\n• Újraindítás szükséges."

msgid "恢復強制簽章驗證"
msgstr "Aláírás-kikényszerítés visszaállítása"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Visszaállítja a Windows alapértelmezett illesztőprogram-aláírás ellenőrzését. Újraindítás szükséges."

msgid "恢復系統安全防護"
msgstr "Rendszerbiztonság visszaállítása"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Visszaállítja a Windows alapértelmezett aláírás-ellenőrzését és kernelbiztonságát.\n\nÚjraindítás szükséges. Biztosan folytatja?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Figyelem: Letiltja az illesztőprogram-aláírás kényszerítését és a memória-integritást, ami jelentősen rontja a biztonságot.\n\nÚjraindítás szükséges. Folytatja?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Figyelem: Engedélyezi a Teszt üzemmódot az aláíratlan illesztőprogramokhoz, ami jelentősen rontja a biztonságot.\n\nÚjraindítás szükséges. Folytatja?"

msgid "解除驅動與核心安全限制"
msgstr "Illesztőprogram- és kernelkorlátok feloldása"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Futtatás] Újraindítás kérése a BIOS/UEFI-be...\n"

