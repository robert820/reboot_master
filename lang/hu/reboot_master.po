msgstr "\n[Futtatás] Egyszeri csökkentett mód (minimális) beállítása...\n"

msgid "[錯誤] {}\n"
msgstr "[Hiba] {}\n"

msgid "\n[執行] 正在設定一次性安全模式 (Network)...\n"
