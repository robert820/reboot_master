msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Azione: {}\n  Dettagli: {}\n  Stato: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Nessuna cronologia attività.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Impossibile ottenere il privilegio di sistema SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Arresto non riuscito, codice di errore: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Impossibile ottenere il privilegio di riavvio SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Riavvio non riuscito, codice di errore: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Impossibile ottenere SeSystemEnvironmentPrivilege. Esegui come amministratore"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "La scheda madre o il SO non supporta il riavvio diretto nel firmware/BIOS"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Impossibile scrivere la variabile UEFI. Bloccato da antivirus o permessi."

msgid "重啟至 BIOS/UEFI"
msgstr "Riavvia in BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Variabile UEFI scritta: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 impostato su 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Preparazione al riavvio"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Variabile UEFI scritta correttamente. Riavvio in BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Esecuzione di bcdedit non riuscita: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` non riuscito: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Impossibile trovare l’hive del registro SOFTWARE del sistema fisico"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Impossibile trovare l’inizio del nuovo GUID nell’output di bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Impossibile trovare la fine del nuovo GUID nell’output di bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Impossibile ottenere il percorso dell’eseguibile corrente: {}"

msgid "一次性安全模式"
msgstr "Modalità provvisoria singola"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Modalità: {}\n  GUID temporaneo: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Modalità provvisoria singola configurata. Riavvio in corso..."

msgid "重啟至進階開機選單"
msgstr "Riavvia in Opzioni di avvio avanzate"

msgid "建立臨時副本 GUID: {}"
msgstr "GUID voce temporanea creato: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Opzioni di avvio avanzate singole configurate. Riavvio in corso..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Riavvia nel firmware BIOS/UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Riavvia subito il PC ed entra automaticamente nella schermata BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Modalità provvisoria singola (minima)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Avvia in modalità provvisoria una sola volta. Torna alla modalità normale al riavvio successivo."

msgid "一次性安全模式 (含網路)"
msgstr "Modalità provvisoria singola (con rete)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Avvia in modalità provvisoria con rete una volta. Torna alla modalità normale al riavvio successivo."

msgid "重啟進入進階開機選單"
msgstr "Riavvia in Opzioni di avvio avanzate"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Riavvia il computer e apre direttamente il menu di avvio avanzato e risoluzione problemi."

msgid "直接強制重啟電腦"
msgstr "Forza riavvio immediato"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Riavvia immediatamente il computer tramite l’API nativa Win32."

msgid "直接安全關機"
msgstr "Arresta in sicurezza"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Spegne immediatamente il computer tramite l’API nativa Win32."

msgid "開啟測試模式 (Test Mode)"
msgstr "Abilita modalità test"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Il sistema accetterà driver con firma di test. Apparirà la filigrana \"Modalità test\".\n\n• È necessario disattivare Secure Boot nel BIOS prima\n• La maggior parte degli anti-cheat (EAC, BattlEye) bloccherà i giochi in questa modalità\n• Riavvio richiesto. Usa \"Disabilita modalità test\" per disattivare"

msgid "關閉測試模式"
msgstr "Disabilita modalità test"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Disabilitare la modalità test ripristina la verifica standard delle firme dei driver. Riavvio richiesto."

msgid "停用驅動程式強制簽章"
msgstr "Disabilita imposizione firma driver"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Disattiva completamente la verifica della firma dei driver Windows (nointegritychecks).\n\n• Consente l’installazione di driver non firmati\n• La sicurezza del sistema sarà notevolmente ridotta\n• È necessario disattivare Secure Boot nel BIOS\n• Riavvio richiesto."

msgid "恢復強制簽章驗證"
msgstr "Ripristina imposizione firma driver"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Ripristina la verifica predefinita delle firme dei driver di Windows. Riavvio richiesto."

msgid "恢復系統安全防護"
msgstr "Ripristina sicurezza del sistema"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ripristina la verifica delle firme e la sicurezza del kernel predefinite.\n\nÈ necessario riavviare per applicare. Continuare?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Avviso: disabilita l’imposizione della firma dei driver e disattiva l’integrità della memoria, riducendo la sicurezza.\n\nRiavvio richiesto per applicare. Continuare?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Avviso: abilita la modalità test per consentire il caricamento di driver non firmati, riducendo la sicurezza.\n\nRiavvio richiesto. Continuare?"

msgid "解除驅動與核心安全限制"
msgstr "Rimuovi limiti di sicurezza driver e kernel"

