msgstr "[Creazione clone] non riuscita: {} \n"

msgid "  [臨時標識] 取得臨時 GUID: {}\n"
msgstr "[Temp GUID] GUID temporaneo acquisito: {} \n"

msgid "  [選單隱藏] 從開機選單中隱藏此臨時副本 (/displayorder ... /remove)...\n"
msgstr "[Nascondi menu] Nascondere il clone temporaneo dal menu di avvio (/displayorder ... /remove)... \n"

msgid "  [模式配置] 設定 safeboot 參數為 {}...\n"
msgstr "[Config] Impostazione del parametro safeboot su {}... \n"

msgid "  [一次性引導] 設定單次啟動序列 (/bootsequence)，重啟後 BootMgr 自動復原...\n"
msgstr "[Avvio singolo] Impostazione della sequenza a scatto singolo (/bootsequence), BootMgr viene ripristinato dopo il riavvio... \n"

msgid "  [開機自毀] 註冊 RunOnce 自毀清理任務 (重啟登入後徹底刪除臨時項目)...\n"
msgstr "[Autodistruzione] Registrazione dell'attività di pulizia RunOnce (elimina permanentemente la voce temporanea dopo l'accesso)... \n"

msgid "母體範本: {}\n  模式: {}\n  臨時 GUID: {}"
msgstr "Modello base: {}\nModalità: {}\nGUID temporaneo: {}"

msgid "  [建立副本] 正在自範本 {} 複製建立臨時進階選單項...\n"
msgstr "[Crea clone] Copia del modello {} per creare una voce temporanea di Opzioni di avvio avanzate... \n"

