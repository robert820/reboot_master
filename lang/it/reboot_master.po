msgstr "Seleziona la lingua di visualizzazione dell’interfaccia."

msgid "繁體中文"
msgstr "Cinese tradizionale"

msgid "简体中文"
msgstr "Cinese semplificato"

msgid "外觀"
msgstr "Aspetto"

