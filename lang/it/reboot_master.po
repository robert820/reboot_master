msgstr "[Crea clone] Copia del modello {} per creare una voce temporanea in modalità provvisoria... \n"

msgid "  [建立副本] 成功建立副本！\n"
msgstr "[Crea clone] Clone creato con successo! \n"

msgid "  [降級備援] 複製範本 {} 失敗: {}，啟動備援嘗試 {{default}}...\n"
msgstr "[Fallback] Copia del modello {} non riuscita: {}, tentativo di fallback con {{default}}... \n"

msgid "  [降級備援] 備援方案複製 {default} 成功！\n"
msgstr "[Fallback] Clone fallback di {default} riuscito! \n"

msgid "  [降級備援] 備援方案亦失敗: {}\n"
msgstr "[Fallback] Anche il clone di fallback non è riuscito: {} \n"

