msgid "未偵測到包含 PE 環境的隨身碟"
msgstr "Ingen USB-enhet med PE-miljö upptäcktes"

msgid "未插入任何隨身碟"
msgstr "Ingen USB-enhet ansluten"

msgid "USB啟動"
msgstr "USB-start"

