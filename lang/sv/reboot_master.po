msgstr "\n[Kör] Stänger av via inbyggt Win32 ExitWindowsEx-API...\n"

msgid "[成功] 已發送 Win32 原生關機信號，系統正在關機...\n"
msgstr "[OK] Inbyggd Win32-avstängningssignal skickad. Stänger av...\n"

msgid "\n[執行] 正在開啟測試模式...\n"
msgstr "\n[Kör] Aktiverar testläge...\n"

msgid "[成功] 測試模式已開啟，請重新開機以生效。桌面右下角將顯示「測試模式」浮水印。\n"
msgstr "[OK] Testläge aktiverat. Starta om för att tillämpa. Vattenstämpel visas på skrivbordet.\n"

msgid "[錯誤] {}\n提示：請先到 BIOS 關閉 Secure Boot 後再嘗試。\n"
msgstr "[Fel] {}\nTips: Inaktivera Secure Boot i BIOS och försök igen.\n"

msgid "\n[執行] 正在關閉測試模式...\n"
msgstr "\n[Kör] Inaktiverar testläge...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[OK] Testläge inaktiverat. Starta om för att tillämpa.\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[Kör] Inaktiverar signaturkrav (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已停用，請重新開機以生效。\n"
msgstr "[OK] Krav på signering inaktiverat. Starta om för att tillämpa.\n"

msgid "[錯誤] {}\n提示：請確認是否具備系統管理員權限，或先到 BIOS 關閉 Secure Boot。\n"
msgstr "[Fel] {}\nTips: Kontrollera administratörsrättigheter eller inaktivera Secure Boot i BIOS.\n"

msgid "\n[執行] 正在恢復強制簽章 (nointegritychecks)...\n"
msgstr "\n[Kör] Återställer krav på signering (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已恢復正常，請重新開機以生效。\n"
msgstr "[OK] Krav på signering återställt. Starta om för att tillämpa.\n"

msgid "\n[執行] 正在恢復系統安全防護...\n"
msgstr "\n[Kör] Återställer systemsäkerhet...\n"

msgid "  [錯誤] 關閉 nointegritychecks 失敗: {}\n"
msgstr "  [Fel] Kunde inte inaktivera nointegritychecks: {}\n"

msgid "  - 驅動強制簽章已恢復\n"
msgstr "  - Krav på drivrutinssignering återställt\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [Fel] Kunde inte inaktivera testsigning: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [Fel] Registerskrivning misslyckades (kod {}): Kunde inte aktivera minnesintegritet\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - Minnesintegritet aktiverad\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - Testläge inaktiverat\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - Systemsäkerhet återställd\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Fel] Registerskrivning misslyckades (felkod {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Varning] Fel uppstod. Kontrollera loggen ovan.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[OK] Säkerhet återställd. Starta om för att tillämpa.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Kör] Inaktiverar drivrutins- och kärnsäkerhetsgränser...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Fel] Kunde inte aktivera nointegritychecks: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Krav på drivrutinssignering inaktiverat\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Fel] Registerskrivning misslyckades (kod {}): Kunde inte inaktivera minnesintegritet\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Minnesintegritet inaktiverad\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Fel] Kunde inte aktivera testsigning: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Testläge aktiverat\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Drivrutinsblockeringslista inaktiverad\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[OK] Säkerhetsbegränsningar hävda. Starta om för att tillämpa.\n"

