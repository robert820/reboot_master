msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Åtgärd: {}\n  Detaljer: {}\n  Status: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Ingen aktivitetshistorik ännu.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Det går inte att erhålla systemprivilegiet SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Avstängning misslyckades, felkod: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Det går inte att få omstartsprivilegiet SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Omstart misslyckades, felkod: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Det går inte att få SeSystemEnvironmentPrivilege. Kör som administratör"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Moderkortet eller operativsystemet stöder inte direkt omstart till BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Kunde inte skriva UEFI-variabel. Blockerad av antivirus eller behörigheter."

msgid "重啟至 BIOS/UEFI"
msgstr "Starta om till BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Skrev UEFI-variabel: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 satt till 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Förbereder omstart"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "UEFI-variabel sparad. Startar om till BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Misslyckades att köra bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` misslyckades: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Kunde inte hitta SOFTWARE-registerdatafilen för det fysiska systemet"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Kunde inte hitta början på nytt GUID i bcdedit-utdata"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Kunde inte hitta slutet på nytt GUID i bcdedit-utdata"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Kunde inte hämta aktuell sökväg för körbar fil: {}"

msgid "一次性安全模式"
msgstr "Engångs felsäkert läge"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Läge: {}\n  Temporärt GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Engångs felsäkert läge konfigurerat. Startar om..."

msgid "重啟至進階開機選單"
msgstr "Starta om till avancerade startalternativ"

msgid "建立臨時副本 GUID: {}"
msgstr "Skapade temporärt GUID: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Engångs avancerade startalternativ konfigurerade. Startar om..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Starta om till BIOS/UEFI-firmware"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Startar om datorn omedelbart och öppnar BIOS/UEFI-inställningarna."

msgid "一次性安全模式 (Minimal)"
msgstr "Engångs felsäkert läge (minimalt)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Startar i felsäkert läge en gång. Återgår till normalt läge vid nästa omstart."

msgid "一次性安全模式 (含網路)"
msgstr "Engångs felsäkert läge (med nätverk)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Startar i felsäkert läge med nätverk en gång. Återgår till normalt läge vid nästa omstart."

msgid "重啟進入進階開機選單"
msgstr "Starta om till avancerade startalternativ"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Startar om datorn och öppnar Windows meny för avancerad start och felsökning."

msgid "直接強制重啟電腦"
msgstr "Tvinga omstart nu"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Startar om datorn omedelbart med det inbyggda Win32-API:et."

msgid "直接安全關機"
msgstr "Stäng av säkert nu"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Stänger av datorn omedelbart med det inbyggda Win32-API:et."

msgid "開啟測試模式 (Test Mode)"
msgstr "Aktivera testläge"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Systemet accepterar testsignerade drivrutiner. Vattenstämpeln \"Testläge\" visas på skrivbordet.\n\n• Secure Boot måste inaktiveras i BIOS först\n• De flesta anti-fusk (EAC, BattlEye) blockerar spel i detta läge\n• Omstart krävs. Använd \"Inaktivera testläge\" för att stänga av"

msgid "關閉測試模式"
msgstr "Inaktivera testläge"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Inaktivering av testläge återställer standardverifiering av drivrutinssignatur. Omstart krävs."

msgid "停用驅動程式強制簽章"
msgstr "Inaktivera krav på drivrutinssignering"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Stänger helt av Windows drivrutinssignaturverifiering (nointegritychecks).\n\n• Tillåter installation av osignerade drivrutiner\n• Systemsäkerheten minskar avsevärt\n• Secure Boot måste inaktiveras i BIOS först\n• Omstart krävs."

msgid "恢復強制簽章驗證"
msgstr "Återställ krav på signering"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Återställer standardverifiering av Windows drivrutinssignaturer. Omstart krävs."

msgid "恢復系統安全防護"
msgstr "Återställ systemsäkerhet"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Återställer standardverifiering av signaturer och kärnsäkerhet i Windows.\n\nOmstart krävs för full effekt. Vill du fortsätta?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Varning: Inaktiverar krav på drivrutinssignering och stänger av minnesintegritet, vilket minskar säkerheten.\n\nOmstart krävs. Vill du fortsätta?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Varning: Aktiverar testläge för att tillåta inläsning av osignerade drivrutiner, vilket minskar säkerheten.\n\nOmstart krävs. Vill du fortsätta?"

msgid "解除驅動與核心安全限制"
msgstr "Inaktivera drivrutins- och kärngränser"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Kör] Begär omstart till BIOS/UEFI...\n"

