msgid "開機控制"
msgstr "Startkontroller"

msgid "電源與開機導向控制"
msgstr "Ström- och startkontroller"

msgid "點擊卡片即可執行操作。安全模式採用無痕自動清除技術。"
msgstr "Klicka på ett kort för att köra. Felsäkert läge rensas automatiskt utan spår."

msgid "WinPE 環境"
msgstr "WinPE-miljö"

msgid "標準 Windows"
msgstr "Standard-Windows"

msgid "操作日誌"
msgstr "Aktivitetslogg"

msgid "BIOS / UEFI 設定"
msgstr "BIOS/UEFI-inställningar"

msgid "重啟並自動進入主機板底層韌體設定畫面"
msgstr "Starta om direkt till moderkortets firmware-inställningar."

msgid "安全模式 (一般)"
msgstr "Felsäkert läge (minimalt)"

msgid "無網路基礎排錯模式，第二次重啟自動復原"
msgstr "Grundläggande felsökning utan nätverk. Återställs vid nästa start."

msgid "重新啟動系統"
msgstr "Starta om systemet"

msgid "呼叫原生 API 強制重新啟動電腦"
msgstr "Tvinga omstart av datorn via inbyggt API."

msgid "進階開機選單"
msgstr "Avancerad startmeny"

msgid "進入 Windows 修復環境 (WinRE) 與啟動設定"
msgstr "Öppna Windows återställningsmiljö (WinRE) och startinställningar."

msgid "自動偵測USB裝置並使用USB裝置啟動"
msgstr "Upptäck automatiskt och starta från USB-enhet."

msgid "安全模式 (含網路)"
msgstr "Felsäkert läge (med nätverk)"

msgid "支援連線之排錯模式，第二次重啟自動復原"
msgstr "Felsökning med nätverksåtkomst. Återställs vid nästa start."

msgid "安全關機"
msgstr "Säker avstängning"

msgid "呼叫原生 API 安全關閉電腦電源"
msgstr "Stäng av datorn säkert via inbyggt API."

msgid "恢復系統安全防護"
