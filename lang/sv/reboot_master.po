msgid "關閉記憶體完整性"
msgstr "Stäng av minnesintegritet"

msgid "恢復預設安全"
msgstr "Återställ standardsäkerhet"

msgid "套用變更"
msgstr "Tillämpa ändringar"

msgid "重啟大師 (Reboot Master)"
msgstr "Reboot Master"

msgid "系統就緒。請選擇操作項目。"
msgstr "Systemet är redo. Välj en åtgärd."

msgid "USB啟動"
msgstr "USB-start"

msgid "掃描 USB 裝置中..."
msgstr "Söker efter USB-enheter..."

msgid "確定要執行此操作？"
