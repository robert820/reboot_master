msgstr "[Fel] {}\n"

msgid "\n[執行] 正在設定一次性安全模式 (Network)...\n"
msgstr "\n[Kör] Konfigurerar engångs felsäkert läge (med nätverk)...\n"

msgid "\n[執行] 正在請求重啟進入進階選單...\n"
msgstr "\n[Kör] Begär omstart till avancerade startalternativ...\n"

msgid "\n[執行] 正在偵測隨身碟並設定重啟進入 PE...\n"
msgstr "\n[Kör] Identifierar USB-enhet och konfigurerar PE-start...\n"

msgid "\n[執行] 正在透過 Win32 ExitWindowsEx 原生 API 重啟電腦...\n"
msgstr "\n[Kör] Startar om via inbyggt Win32 ExitWindowsEx-API...\n"

