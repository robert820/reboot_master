msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] 작업: {}\n  세부 정보: {}\n  상태: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "작업 기록이 아직 없습니다.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "SeShutdownPrivilege 시스템 종료 권한을 얻을 수 없습니다."

msgid "關機失敗，錯誤碼: {}"
msgstr "시스템 종료 실패, 오류 코드: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "SeShutdownPrivilege 다시 시작 권한을 얻을 수 없습니다."

msgid "重啟失敗，錯誤碼: {}"
msgstr "다시 시작 실패, 오류 코드: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "시스템 환경 권한(SeSystemEnvironmentPrivilege)을 가져올 수 없습니다. 관리자 권한으로 실행했는지 확인하세요."

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "현재 메인보드 또는 OS에서 펌웨어/BIOS 설정으로 직접 다시 시작을 지원하지 않습니다."

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "UEFI 펌웨어 변수 쓰기 실패. 백신 프로그램 또는 권한 문제를 확인하세요."

msgid "重啟至 UEFI BIOS"
msgstr "UEFI BIOS로 다시 시작"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "UEFI 변수 작성: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), 비트 0을 1로 설정 (BootToFwUI)"

msgid "準備重啟"
msgstr "다시 시작 준비 중"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 UEFI BIOS..."
msgstr "UEFI 변수가 작성되었습니다. UEFI BIOS로 다시 시작하는 중..."

msgid "執行 bcdedit 失敗: {}"
msgstr "bcdedit 실행 실패: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` 실행 실패: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "물리 시스템의 SOFTWARE 레지스트리 하이브를 찾을 수 없습니다."

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "bcdedit 출력에서 새 GUID 시작 부분을 찾을 수 없습니다."

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "bcdedit 출력에서 새 GUID 끝 부분을 찾을 수 없습니다."

msgid "無法獲取當前執行檔路徑: {}"
msgstr "현재 실행 파일 경로를 가져올 수 없습니다: {}"

msgid "一次性安全模式"
msgstr "일회성 안전 모드"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "모드: {}\n  임시 GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "일회성 안전 모드가 설정되었습니다. 다시 시작하는 중..."

msgid "重啟至進階開機選單"
msgstr "고급 시작 옵션으로 다시 시작"

msgid "建立臨時副本 GUID: {}"
msgstr "임시 항목 GUID 생성됨: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "일회성 고급 시작 옵션이 설정되었습니다. 다시 시작하는 중..."

msgid "重啟進入 UEFI BIOS"
msgstr "UEFI BIOS 펌웨어로 다시 시작"

msgid "此操作將立即重新啟動電腦並自動進入 UEFI BIOS 設定畫面。"
msgstr "컴퓨터를 즉시 다시 시작하고 UEFI BIOS 설정 화면으로 자동 진입합니다."

msgid "一次性安全模式 (Minimal)"
msgstr "일회성 안전 모드(최소)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "다음 부팅 시 안전 모드로 진입합니다. 두 번째 재부팅 시 정상 모드로 자동 복원됩니다."

msgid "一次性安全模式 (含網路)"
msgstr "일회성 안전 모드(네트워킹 사용)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "다음 부팅 시 네트워킹을 지원하는 안전 모드로 진입합니다. 두 번째 재부팅 시 정상 모드로 자동 복원됩니다."

msgid "重啟進入進階開機選單"
msgstr "고급 시작 옵션으로 다시 시작"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "컴퓨터를 다시 시작하고 Windows 고급 시작 및 문제 해결 메뉴를 직접 엽니다."

msgid "直接強制重啟電腦"
msgstr "컴퓨터 강제 다시 시작"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Win32 네이티브 API를 통해 컴퓨터를 즉시 다시 시작합니다."

msgid "直接安全關機"
msgstr "안전하게 시스템 종료"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Win32 네이티브 API를 통해 컴퓨터 전원을 즉시 끕니다."

msgid "開啟測試模式 (Test Mode)"
msgstr "테스트 모드 활성화"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "시스템이 테스트 서명된 드라이버를 허용합니다. 바탕화면 우측 하단에 \"테스트 모드\" 워터마크가 표시됩니다.\n\n• BIOS에서 Secure Boot를 먼저 비활성화해야 합니다.\n• 대부분의 안티치트(EAC, BattlEye)가 이 모드에서 게임 실행을 차단합니다.\n• 적용하려면 재부팅이 필요합니다. 끄려면 \"테스트 모드 비활성화\"를 실행하세요."

msgid "關閉測試模式"
msgstr "테스트 모드 비활성화"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "테스트 모드를 끄면 표준 드라이버 서명 확인이 복원됩니다. 재부팅이 필요합니다."

msgid "停用驅動程式強制簽章"
msgstr "드라이버 서명 적용 비활성화"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Windows 드라이버 디지털 서명 확인(nointegritychecks)을 완전히 끕니다.\n\n• 디지털 서명이 없는 드라이버 설치 허용\n• 시스템 보안이 크게 저하됨\n• BIOS에서 Secure Boot를 먼저 비활성화해야 함\n• 재부팅 후 적용됩니다."

msgid "恢復強制簽章驗證"
msgstr "드라이버 서명 적용 복원"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Windows 기본 드라이버 디지털 서명 확인 메커니즘을 복원합니다. 재부팅이 필요합니다."

msgid "恢復系統安全防護"
msgstr "시스템 보안 복원"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Windows 기본 디지털 서명 확인 및 커널 보안 메커니즘을 복원합니다.\n\n완전히 적용하려면 재부팅이 필요합니다. 계속하시겠습니까?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "경고: 드라이버 서명 적용(nointegritychecks)을 비활성화하고 메모리 무결성을 꺼 시스템 보안이 크게 저하됩니다.\n\n완전히 적용하려면 재부팅이 필요합니다. 계속하시겠습니까?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "경고: 서명되지 않은 드라이버 로드를 허용하는 테스트 모드를 켜면 시스템 보안이 크게 저하됩니다.\n\n완전히 적용하려면 재부팅이 필요합니다. 계속하시겠습니까?"

msgid "解除驅動與核心安全限制"
msgstr "드라이버 및 커널 보안 제한 해제"

msgid "\n[執行] 正在請求重啟至 UEFI BIOS...\n"
msgstr "\n[실행] UEFI BIOS 재시작 요청 중...\n"

msgid "[成功] {}\n"
msgstr "[성공] {}\n"

msgid "[提示/錯誤] {}\n"
msgstr "[알림/오류] {}\n"

msgid "\n[執行] 正在設定一次性安全模式 (Minimal)...\n"
msgstr "\n[실행] 일회성 안전 모드(최소) 설정 중...\n"

msgid "[錯誤] {}\n"
msgstr "[오류] {}\n"

msgid "\n[執行] 正在設定一次性安全模式 (Network)...\n"
msgstr "\n[실행] 일회성 안전 모드(네트워킹 사용) 설정 중...\n"

msgid "\n[執行] 正在請求重啟進入進階選單...\n"
msgstr "\n[실행] 고급 시작 옵션으로 다시 시작 요청 중...\n"

msgid "\n[執行] 正在偵測隨身碟並設定重啟進入 PE...\n"
msgstr "\n[실행] USB 드라이브 감지 및 PE 부팅 구성 중...\n"

msgid "\n[執行] 正在透過 Win32 ExitWindowsEx 原生 API 重啟電腦...\n"
msgstr "\n[실행] Win32 ExitWindowsEx 네이티브 API로 컴퓨터 다시 시작 중...\n"

msgid "[成功] 已發送 Win32 原生重啟信號，系統正在重啟...\n"
msgstr "[성공] Win32 네이티브 다시 시작 신호 전송됨. 다시 시작하는 중...\n"

msgid "[API失敗] {}"
msgstr "[API 실패] {}"

msgid "\n[執行] 正在透過 Win32 ExitWindowsEx 原生 API 關閉電腦...\n"
msgstr "\n[실행] Win32 ExitWindowsEx 네이티브 API로 컴퓨터 종료 중...\n"

msgid "[成功] 已發送 Win32 原生關機信號，系統正在關機...\n"
msgstr "[성공] Win32 네이티브 종료 신호 전송됨. 종료 중...\n"

msgid "\n[執行] 正在開啟測試模式...\n"
msgstr "\n[실행] 테스트 모드 활성화 중...\n"

msgid "[成功] 測試模式已開啟，請重新開機以生效。桌面右下角將顯示「測試模式」浮水印。\n"
msgstr "[성공] 테스트 모드가 활성화되었습니다. 재부팅하세요. 바탕화면에 \"테스트 모드\" 워터마크가 표시됩니다.\n"

msgid "[錯誤] {}\n提示：請先到 BIOS 關閉 Secure Boot 後再嘗試。\n"
msgstr "[오류] {}\n힌트: BIOS에서 Secure Boot를 비활성화한 후 다시 시도하세요.\n"

msgid "\n[執行] 正在關閉測試模式...\n"
msgstr "\n[실행] 테스트 모드 비활성화 중...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[성공] 테스트 모드가 비활성화되었습니다. 재부팅하세요.\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[실행] 드라이버 서명 적용(nointegritychecks) 비활성화 중...\n"

msgid "[成功] 強制簽章驗證已停用，請重新開機以生效。\n"
msgstr "[성공] 드라이버 서명 적용이 비활성화되었습니다. 재부팅하세요.\n"

msgid "[錯誤] {}\n提示：請確認是否具備系統管理員權限，或先到 BIOS 關閉 Secure Boot。\n"
msgstr "[오류] {}\n힌트: 관리자 권한을 확인하거나, BIOS에서 Secure Boot를 비활성화하세요.\n"

msgid "\n[執行] 正在恢復強制簽章 (nointegritychecks)...\n"
msgstr "\n[실행] 드라이버 서명 적용(nointegritychecks) 복원 중...\n"

msgid "[成功] 強制簽章驗證已恢復正常，請重新開機以生效。\n"
msgstr "[성공] 드라이버 서명 적용이 복원되었습니다. 재부팅하세요.\n"

msgid "\n[執行] 正在恢復系統安全防護...\n"
msgstr "\n[실행] 시스템 보안 복원 중...\n"

msgid "  [錯誤] 關閉 nointegritychecks 失敗: {}\n"
msgstr "  [오류] nointegritychecks 끄기 실패: {}\n"

msgid "  - 驅動強制簽章已恢復\n"
msgstr "  - 드라이버 서명 적용 복원됨\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [오류] testsigning 끄기 실패: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [오류] 레지스트리 쓰기 실패(코드 {}): 메모리 무결성을 켤 수 없습니다.\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - 메모리 무결성 활성화됨\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - 테스트 모드 비활성화됨\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - 시스템 보안 복원됨\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [오류] 레지스트리 쓰기 실패(오류 코드 {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[경고] 처리 중 오류가 발생했습니다. 위 로그를 확인하세요.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[성공] 보안 설정이 복원되었습니다. 재부팅하세요.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[실행] 드라이버 및 커널 보안 제한 해제 중...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [오류] nointegritychecks 켜기 실패: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - 드라이버 서명 적용 비활성화됨\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [오류] 레지스트리 쓰기 실패(코드 {}): 메모리 무결성을 끌 수 없습니다.\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - 메모리 무결성 꺼짐\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [오류] testsigning 켜기 실패: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - 테스트 모드 활성화됨\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - 드라이버 차단 목록 꺼짐\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
