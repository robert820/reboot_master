msgstr "[{}] Амал: {}\n  Тафсилотлар: {}\n  Ҳолати: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Ҳозирча фаолият тарихи йўқ.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "SeShutdownPrivilege тизим имтиёзини олиб бўлмади"

msgid "關機失敗，錯誤碼: {}"
msgstr "Ўчириш амалга ошмади, хато коди: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "SeShutdownPrivilege қайта ишга тушириш имтиёзини олиб бўлмади"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Қайта ишга тушириш амалга ошмади, хато коди: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "SeSystemEnvironmentPrivilege имтиёзи олинмади. Администратор сифатида ишга туширинг"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Она плата ёки ОТ тўғридан-тўғри BIOS/UEFI созламаларига қайта ишга туширишни қўллаб-қувватламайди"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "UEFI ўзгарувчисини ёзиш амалга ошмади. Антивирус ёки рухсатлар томонидан блокланган."

msgid "重啟至 BIOS/UEFI"
msgstr "BIOS/UEFI-га қайта ишга тушириш"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "UEFI ўзгарувчиси ёзилди: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Бит 0 1 га ўрнатилди (BootToFwUI)"

msgid "準備重啟"
msgstr "Қайта ишга туширишга тайёрланмоқда"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "UEFI ўзгарувчиси муваффақиятли ёзилди. BIOS/UEFI-га қайта ишга туширилмоқда..."

msgid "執行 bcdedit 失敗: {}"
msgstr "bcdedit бажарилмади: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` бажарилмади: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Жисмоний тизимнинг SOFTWARE реестр уяси топилмади"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "bcdedit чиқишида янги GUID бошланиши топилмади"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "bcdedit чиқишида янги GUID охири топилмади"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Жорий бажарилувчи файл йўлини олиб бўлмади: {}"

msgid "一次性安全模式"
msgstr "Бир марталик хавфсиз режим"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Режим: {}\n  Вақтинчалик GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Бир марталик хавфсиз режим созланди. Қайта ишга туширилмоқда..."

msgid "重啟至進階開機選單"
msgstr "Кенгайтирилган юклаш менюсига қайта ишга тушириш"

msgid "建立臨時副本 GUID: {}"
msgstr "Вақтинчалик ёзув GUID яратилди: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Бир марталик кенгайтирилган юклаш параметрлари созланди. Қайта ишга туширилмоқда..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "BIOS / UEFI микропрограммасига қайта ишга тушириш"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Компьютерни дарҳол қайта ишга туширади ва BIOS/UEFI созламаларига автоматик киради."

msgid "一次性安全模式 (Minimal)"
msgstr "Бир марталик хавфсиз режим (минимал)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Бир марта хавфсиз режимда юкланади. Кейинги қайта ишга туширишда одатий режимга қайтади."

msgid "一次性安全模式 (含網路)"
msgstr "Бир марталик хавфсиз режим (тармоқ билан)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Бир марта тармоқли хавфсиз режимда юкланади. Кейинги қайта ишга туширишда одатий режимга қайтади."

msgid "重啟進入進階開機選單"
msgstr "Кенгайтирилган ишга тушириш параметрларига қайта ишга тушириш"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Компьютерни қайта ишга туширади ва Windows кенгайтирилган ишга тушириш менюсини очади."

msgid "直接強制重啟電腦"
msgstr "Мажбурий қайта ишга тушириш"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Маҳаллий Win32 API орқали компютерингизни дарҳол қайта ишга туширади."

msgid "直接安全關機"
msgstr "Хавфсиз ўчириш"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Маҳаллий Win32 API орқали компютерингизни дарҳол ўчиради."

msgid "開啟測試模式 (Test Mode)"
msgstr "Тест режимини ёқиш"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Тизим тест имзоли драйверларни қабул қилади. Иш столида \"Тест режими\" белгиси пайдо бўлади.\n\n• Аввал BIOS’да Secure Boot ўчирилиши керак\n• Кўпчилик anti-cheat тизимлари (EAC, BattlEye) ўйинларни блоклайди\n• Кучга кириши учун қайта ишга тушириш талаб қилинади"

msgid "關閉測試模式"
msgstr "Тест режимини ўчириш"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Тест режимини ўчириш стандарт драйвер имзосини текширишни тиклайди. Қайта ишга тушириш талаб қилинади."

msgid "停用驅動程式強制簽章"
msgstr "Драйвер имзосини мажбурлашни ўчириш"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Windows драйвер рақамли имзосини текширишни бутунлай ўчиради (nointegritychecks).\n\n• Имзоланмаган драйверларни ўрнатишга рухсат беради\n• Тизим хавфсизлиги сезиларли даражада пасаяди\n• Аввал BIOS’да Secure Boot ўчирилиши керак\n• Қайта ишга тушириш талаб қилинади."

msgid "恢復強制簽章驗證"
msgstr "Имзони мажбурлашни тиклаш"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Windows стандарт драйвер рақамли имзосини текшириш механизмини тиклайди. Қайта ишга тушириш талаб қилинади."

msgid "恢復系統安全防護"
msgstr "Тизим хавфсизлигини тиклаш"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Windows стандарт имзо текшируви ва ядро хавфсизлигини тиклайди.\n\nТўлиқ кучга кириши учун қайта ишга тушириш керак. Давом эттирилсинми?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Огоҳлантириш: Драйвер имзосини мажбурлаш ва хотира яхлитлигини ўчириб, хавфсизликни сезиларли даражада пасайтиради.\n\nҚайта ишга тушириш талаб қилинади. Давом эттирилсинми?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Огоҳлантириш: Имзоланмаган драйверларни юклаш учун тест режимини ёқади, бу хавфсизликни сезиларли даражада пасайтиради.\n\nҚайта ишга тушириш керак. Давом эттирилсинми?"

msgid "解除驅動與核心安全限制"
msgstr "Драйвер ва ядро хавфсизлик чекловларини олиб ташлаш"

