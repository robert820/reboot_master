msgstr "Η επανεκκίνηση απέτυχε, κωδικός σφάλματος: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Δεν είναι δυνατή η απόκτηση του SeSystemEnvironmentPrivilege. Εκτελέστε ως διαχειριστής"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Η μητρική κάρτα ή το λειτουργικό δεν υποστηρίζει άμεση επανεκκίνηση στο BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Αποτυχία εγγραφής μεταβλητής UEFI. Αποκλείστηκε από antivirus ή δικαιώματα."

msgid "重啟至 BIOS/UEFI"
msgstr "Επανεκκίνηση στο BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Εγγραφή μεταβλητής UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 σε 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Προετοιμασία για επανεκκίνηση"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Η μεταβλητή UEFI γράφτηκε με επιτυχία. Επανεκκίνηση στο BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Αποτυχία εκτέλεσης του bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "Το `bcdedit {}` απέτυχε: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Δεν βρέθηκε η κυψέλη μητρώου SOFTWARE του φυσικού συστήματος"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Δεν βρέθηκε η αρχή του νέου GUID στην έξοδο του bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Δεν βρέθηκε το τέλος του νέου GUID στην έξοδο του bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Δεν είναι δυνατή η λήψη της διαδρομής του εκτελέσιμου αρχείου: {}"

msgid "一次性安全模式"
msgstr "Εφάπαξ ασφαλής λειτουργία"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Λειτουργία: {}\n  Προσωρινό GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Η εφάπαξ ασφαλής λειτουργία ρυθμίστηκε επιτυχώς. Επανεκκίνηση..."

msgid "重啟至進階開機選單"
msgstr "Επανεκκίνηση στις επιλογές εκκίνησης για προχωρημένους"

msgid "建立臨時副本 GUID: {}"
msgstr "Δημιουργήθηκε GUID προσωρινής καταχώρισης: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Ρυθμίστηκαν οι εφάπαξ επιλογές εκκίνησης. Επανεκκίνηση..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Επανεκκίνηση στο υλικολογισμικό BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Επανεκκινεί αμέσως τον υπολογιστή και εισέρχεται αυτόματα στις ρυθμίσεις BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Εφάπαξ ασφαλής λειτουργία (Ελάχιστη)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Εκκινεί σε ασφαλή λειτουργία μία φορά. Επανέρχεται στην κανονική κατάσταση στην επόμενη επανεκκίνηση."

msgid "一次性安全模式 (含網路)"
msgstr "Εφάπαξ ασφαλής λειτουργία (με δίκτυο)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Εκκινεί σε ασφαλή λειτουργία με δίκτυο μία φορά. Επανέρχεται στην κανονική κατάσταση στην επόμενη επανεκκίνηση."

msgid "重啟進入進階開機選單"
msgstr "Επανεκκίνηση στις επιλογές εκκίνησης για προχωρημένους"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Επανεκκινεί τον υπολογιστή και ανοίγει το μενού εκκίνησης και αντιμετώπισης προβλημάτων."

msgid "直接強制重啟電腦"
msgstr "Άμεση αναγκαστική επανεκκίνηση"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Επανεκκινεί αμέσως τον υπολογιστή σας μέσω του εγγενούς Win32 API."

msgid "直接安全關機"
msgstr "Ασφαλής τερματισμός τώρα"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Απενεργοποιεί αμέσως τον υπολογιστή σας μέσω του εγγενούς Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Ενεργοποίηση λειτουργίας δοκιμής"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Το σύστημα θα δέχεται δοκιμαστικά προγράμματα οδήγησης. Εμφανίζεται υδατογράφημα \"Λειτουργία δοκιμής\".\n\n• Πρέπει πρώτα να απενεργοποιηθεί το Secure Boot στο BIOS\n• Τα περισσότερα anti-cheat (EAC, BattlEye) θα μπλοκάρουν παιχνίδια\n• Απαιτείται επανεκκίνηση. Επιλέξτε \"Απενεργοποίηση λειτουργίας δοκιμής\" για κλείσιμο"

msgid "關閉測試模式"
msgstr "Απενεργοποίηση λειτουργίας δοκιμής"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Η απενεργοποίηση επαναφέρει την τυπική επαλήθευση υπογραφών προγραμμάτων οδήγησης. Απαιτείται επανεκκίνηση."

msgid "停用驅動程式強制簽章"
msgstr "Απενεργοποίηση επιβολής υπογραφής προγράμματος οδήγησης"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Απενεργοποιεί πλήρως την επαλήθευση υπογραφών προγραμμάτων οδήγησης (nointegritychecks).\n\n• Επιτρέπει την εγκατάσταση μη υπογεγραμμένων προγραμμάτων οδήγησης\n• Η ασφάλεια μειώνεται σημαντικά\n• Πρέπει να απενεργοποιηθεί το Secure Boot στο BIOS\n• Απαιτείται επανεκκίνηση."

msgid "恢復強制簽章驗證"
msgstr "Επαναφορά επιβολής υπογραφής"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Επαναφέρει την προεπιλεγμένη επαλήθευση ψηφιακής υπογραφής των Windows. Απαιτείται επανεκκίνηση."

msgid "恢復系統安全防護"
msgstr "Επαναφορά ασφάλειας συστήματος"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Επαναφέρει την προεπιλεγμένη επαλήθευση υπογραφών και την ασφάλεια πυρήνα.\n\nΑπαιτείται επανεκκίνηση. Θέλετε να συνεχίσετε;"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Προειδοποίηση: Απενεργοποιεί την επιβολή υπογραφής και την ακεραιότητα μνήμης, μειώνοντας σημαντικά την ασφάλεια.\n\nΑπαιτείται επανεκκίνηση. Θέλετε να συνεχίσετε;"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Προειδοποίηση: Ενεργοποιεί τη λειτουργία δοκιμής για μη υπογεγραμμένους οδηγούς, μειώνοντας την ασφάλεια.\n\nΑπαιτείται επανεκκίνηση. Θέλετε να συνεχίσετε;"

msgid "解除驅動與核心安全限制"
msgstr "Κατάργηση ορίων ασφαλείας προγραμμάτων οδήγησης & πυρήνα"

