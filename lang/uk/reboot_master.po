msgstr "[{}] Дія: {}\n  Деталі: {}\n  Статус: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Історії дій ще немає.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Не вдалося отримати системний привілей SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Збій завершення роботи, код помилки: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Не вдалося отримати привілей перезавантаження SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Збій перезавантаження, код помилки: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Не вдалося отримати SeSystemEnvironmentPrivilege. Запустіть від імені адміністратора"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Материнська плата або ОС не підтримує перезавантаження в налаштування BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Не вдалося записати змінну UEFI. Заблоковано антивірусом або дозволами."

msgid "重啟至 BIOS/UEFI"
msgstr "Перезавантажити в BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Записано змінну UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), біт 0 встановлено в 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Підготовка до перезавантаження"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Змінну UEFI успішно записано. Перезавантаження в BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Не вдалося виконати bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` не вдалося: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Не знайдено кущ реєстру SOFTWARE фізичної системи"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Не вдалося знайти початок нового GUID у виводі bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Не вдалося знайти кінець нового GUID у виводі bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Не вдалося отримати шлях до поточного виконуваного файлу: {}"

msgid "一次性安全模式"
msgstr "Одноразовий безпечний режим"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Режим: {}\n  Тимчасовий GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Одноразовий безпечний режим налаштовано. Перезавантаження..."

msgid "重啟至進階開機選單"
msgstr "Перезавантажити в розширене меню завантаження"

msgid "建立臨時副本 GUID: {}"
msgstr "Створено тимчасовий GUID запису: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Одноразові додаткові параметри запуску налаштовано. Перезавантаження..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Перезавантажити у прошивку BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Негайно перезавантажує комп’ютер і автоматично відкриває налаштування BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Одноразовий безпечний режим (мінімальний)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Одноразове завантаження в безпечному режимі. При наступному перезапуску повернеться звичайний режим."

msgid "一次性安全模式 (含網路)"
msgstr "Одноразовий безпечний режим (із мережею)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Одноразове завантаження в безпечному режимі з мережею. При наступному перезапуску повернеться звичайний режим."

msgid "重啟進入進階開機選單"
msgstr "Перезавантажити в розширені параметри запуску"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Перезавантажує комп’ютер і відкриває меню розширеного запуску та виправлення неполадок Windows."

msgid "直接強制重啟電腦"
msgstr "Примусово перезавантажити зараз"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Негайно перезавантажує комп’ютер за допомогою нативного Win32 API."

msgid "直接安全關機"
msgstr "Безпечне вимкнення зараз"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Негайно вимикає комп’ютер за допомогою нативного Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Увімкнути тестовий режим"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Система прийматиме драйвери з тестовим підписом. На робочому столі з’явиться водяний знак «Тестовий режим».\n\n• Спочатку потрібно вимкнути Secure Boot у BIOS\n• Більшість античітів (EAC, BattlEye) блокуватимуть ігри в цьому режимі\n• Потрібне перезавантаження. Скористайтеся «Вимкнути тестовий режим» для вимкнення"

msgid "關閉測試模式"
msgstr "Вимкнути тестовий режим"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Вимкнення тестового режиму відновлює стандартну перевірку підписів драйверів. Потрібне перезавантаження."

msgid "停用驅動程式強制簽章"
msgstr "Вимкнути обов’язкову перевірку підпису драйверів"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Повністю вимикає перевірку цифрових підписів драйверів Windows (nointegritychecks).\n\n• Дозволяє встановлення непідписаних драйверів\n• Безпека системи значно знизиться\n• Спочатку потрібно вимкнути Secure Boot у BIOS\n• Потрібне перезавантаження."

msgid "恢復強制簽章驗證"
msgstr "Відновити обов’язкову перевірку підпису"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Відновлює стандартну перевірку цифрових підписів драйверів Windows. Потрібне перезавантаження."

msgid "恢復系統安全防護"
msgstr "Відновити захист системи"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Відновить стандартну перевірку підписів і безпеку ядра Windows.\n\nПотрібне перезавантаження для повного застосування. Продовжити?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Попередження: вимикає обов’язковий підпис драйверів і цілісність пам’яті, що суттєво знижує безпеку системи.\n\nПотрібне перезавантаження. Продовжити?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Попередження: вмикає тестовий режим для завантаження непідписаних драйверів, знижуючи безпеку системи.\n\nПотрібне перезавантаження. Продовжити?"

msgid "解除驅動與核心安全限制"
msgstr "Зняти обмеження безпеки драйверів і ядра"

