msgstr "[{}] Aktion: {}\n  Details: {}\n  Status: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Noch kein Aktivitätsverlauf vorhanden.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Systemberechtigung SeShutdownPrivilege konnte nicht abgerufen werden"

msgid "關機失敗，錯誤碼: {}"
msgstr "Herunterfahren fehlgeschlagen, Fehlercode: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Neustartberechtigung SeShutdownPrivilege konnte nicht abgerufen werden"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Neustart fehlgeschlagen, Fehlercode: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "SeSystemEnvironmentPrivilege konnte nicht abgerufen werden. Bitte als Administrator ausführen"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Hauptplatine oder Betriebssystem unterstützt keinen direkten Neustart in UEFI/BIOS"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Schreiben der UEFI-Variable fehlgeschlagen. Durch Antivirus oder Berechtigung blockiert."

msgid "重啟至 BIOS/UEFI"
msgstr "Neustart ins BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "UEFI-Variable geschrieben: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 auf 1 gesetzt (BootToFwUI)"

msgid "準備重啟"
msgstr "Neustart wird vorbereitet"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "UEFI-Variable erfolgreich geschrieben. Neustart ins BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Ausführung von bcdedit fehlgeschlagen: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` fehlgeschlagen: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "SOFTWARE-Registrierungsstruktur des physischen Systems nicht gefunden"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Start der neuen GUID in der bcdedit-Ausgabe nicht gefunden"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Ende der neuen GUID in der bcdedit-Ausgabe nicht gefunden"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Aktueller Pfad der ausführbaren Datei konnte nicht abgerufen werden: {}"

msgid "一次性安全模式"
msgstr "Einmaliger abgesicherter Modus"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Modus: {}\n  Temporäre GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Einmaliger abgesicherter Modus konfiguriert. System startet neu..."

msgid "重啟至進階開機選單"
msgstr "Neustart in erweiterte Startoptionen"

msgid "建立臨時副本 GUID: {}"
msgstr "Temporäre Eintrags-GUID erstellt: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Einmalige erweiterte Startoptionen konfiguriert. System startet neu..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Neustart in BIOS-/UEFI-Firmware"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Startet den PC sofort neu und öffnet automatisch das BIOS/UEFI-Setup."

msgid "一次性安全模式 (Minimal)"
msgstr "Einmaliger abgesicherter Modus (Minimal)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Startet einmal im abgesicherten Modus. Kehrt beim nächsten Neustart automatisch zum Normalmodus zurück."

msgid "一次性安全模式 (含網路)"
msgstr "Einmaliger abgesicherter Modus (mit Netzwerktreibern)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Startet einmal im abgesicherten Modus mit Netzwerk. Kehrt beim nächsten Neustart zum Normalmodus zurück."

msgid "重啟進入進階開機選單"
msgstr "Neustart in erweiterte Startoptionen"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Startet den PC neu und öffnet das erweiterte Windows-Start- und Problembehandlungsmenü."

msgid "直接強制重啟電腦"
msgstr "Sofortigen Neustart erzwingen"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Startet Ihren PC sofort über die native Win32-API neu."

msgid "直接安全關機"
msgstr "Sicher herunterfahren"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Schaltet Ihren PC sofort über die native Win32-API aus."

msgid "開啟測試模式 (Test Mode)"
msgstr "Testmodus aktivieren"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "System akzeptiert testsignierte Treiber. Wasserzeichen „Testmodus“ erscheint auf dem Desktop.\n\n• Secure Boot muss zuerst im BIOS deaktiviert werden\n• Die meisten Anti-Cheat-Systeme (EAC, BattlEye) blockieren Spiele in diesem Modus\n• Neustart erforderlich. Verwenden Sie „Testmodus deaktivieren“ zum Ausschalten"

msgid "關閉測試模式"
msgstr "Testmodus deaktivieren"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Deaktivieren des Testmodus stellt die Standard-Treibersignaturprüfung wieder her. Neustart erforderlich."

msgid "停用驅動程式強制簽章"
msgstr "Erzwingen der Treibersignatur deaktivieren"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Deaktiviert die Windows-Treibersignaturprüfung vollständig (nointegritychecks).\n\n• Erlaubt die Installation unsignierter Treiber\n• Systemsicherheit wird erheblich reduziert\n• Secure Boot muss zuerst im BIOS deaktiviert werden\n• Neustart erforderlich."

msgid "恢復強制簽章驗證"
msgstr "Treibersignaturerzwingung wiederherstellen"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Stellt die standardmäßige Windows-Treibersignaturprüfung wieder her. Neustart erforderlich."

msgid "恢復系統安全防護"
msgstr "Systemsicherheit wiederherstellen"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Stellt die standardmäßige Signaturprüfung und Kernelsicherheit wieder her.\n\nNeustart erforderlich. Fortfahren?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Warnung: Deaktiviert die Treibersignaturerzwingung und Speicher-Integrität, was die Sicherheit stark verringert.\n\nNeustart erforderlich. Fortfahren?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Warnung: Aktiviert den Testmodus, um unsignierte Treiber zu laden, was die Sicherheit verringert.\n\nNeustart erforderlich. Fortfahren?"

msgid "解除驅動與核心安全限制"
msgstr "Treiber- und Kernelsicherheitsgrenzen aufheben"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Ausführen] Neustart ins BIOS/UEFI wird angefordert...\n"

