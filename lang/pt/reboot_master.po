msgstr "Reiniciar no BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Variável UEFI gravada: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 definido como 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Preparando para reiniciar"

