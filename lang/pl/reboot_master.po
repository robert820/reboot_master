msgstr "\n[Uruchom] Wykrywanie dysku USB i konfigurowanie rozruchu PE...\n"

msgid "\n[執行] 正在透過 Win32 ExitWindowsEx 原生 API 重啟電腦...\n"
msgstr "\n[Uruchom] Ponowne uruchamianie przez natywny interfejs Win32 ExitWindowsEx...\n"

msgid "[成功] 已發送 Win32 原生重啟信號，系統正在重啟...\n"
msgstr "[OK] Wysłano sygnał restartu Win32. Ponowne uruchamianie...\n"

