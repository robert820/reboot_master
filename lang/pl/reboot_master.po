msgstr "\n[Uruchom] Konfigurowanie jednorazowego trybu awaryjnego (minimalnego)...\n"

msgid "[錯誤] {}\n"
msgstr "[Błąd] {}\n"

msgid "\n[執行] 正在設定一次性安全模式 (Network)...\n"
