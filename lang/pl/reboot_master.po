msgid "無法讀取選擇結果"
msgstr "Nie można odczytać wyboru"

msgid "未找到指定的 PE 隨身碟，請重新掃描。"
msgstr "Nie znaleziono wskazanego dysku USB z PE. Zeskanuj ponownie."

msgid "ramdisksdidevice 失敗: {}"
msgstr "ramdisksdidevice nie powiodło się: {}"

msgid "ramdisksdipath 失敗: {}"
msgstr "ramdisksdipath nie powiodło się: {}"

msgid "執行 bcdedit /create 失敗: {}"
msgstr "bcdedit /create nie powiodło się: {}"

msgid "set device 失敗: {}"
msgstr "set device nie powiodło się: {}"

msgid "set osdevice 失敗: {}"
msgstr "set osdevice nie powiodło się: {}"

msgid "set path 失敗: {}"
msgstr "set path nie powiodło się: {}"

