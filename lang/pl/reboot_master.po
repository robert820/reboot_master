msgstr "[Błąd API] {}"

msgid "\n[執行] 正在透過 Win32 ExitWindowsEx 原生 API 關閉電腦...\n"
msgstr "\n[Uruchom] Zamykanie przez natywny interfejs Win32 ExitWindowsEx...\n"

msgid "[成功] 已發送 Win32 原生關機信號，系統正在關機...\n"
msgstr "[OK] Wysłano sygnał zamknięcia Win32. Wyłączanie komputera...\n"

msgid "\n[執行] 正在開啟測試模式...\n"
msgstr "\n[Uruchom] Włączanie trybu testowego...\n"

msgid "[成功] 測試模式已開啟，請重新開機以生效。桌面右下角將顯示「測試模式」浮水印。\n"
msgstr "[OK] Tryb testowy włączony. Uruchom ponownie, aby zastosować. Znak wodny pojawi się na pulpicie.\n"

msgid "[錯誤] {}\n提示：請先到 BIOS 關閉 Secure Boot 後再嘗試。\n"
msgstr "[Błąd] {}\nWskazówka: Wyłącz Secure Boot w BIOS-ie i spróbuj ponownie.\n"

msgid "\n[執行] 正在關閉測試模式...\n"
msgstr "\n[Uruchom] Wyłączanie trybu testowego...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[OK] Tryb testowy wyłączony. Uruchom ponownie, aby zastosować.\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[Uruchom] Wyłączanie wymuszania podpisów (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已停用，請重新開機以生效。\n"
msgstr "[OK] Wymuszanie podpisów wyłączone. Uruchom ponownie, aby zastosować.\n"

msgid "[錯誤] {}\n提示：請確認是否具備系統管理員權限，或先到 BIOS 關閉 Secure Boot。\n"
msgstr "[Błąd] {}\nWskazówka: Sprawdź uprawnienia administratora lub wyłącz Secure Boot w BIOS-ie.\n"

msgid "\n[執行] 正在恢復強制簽章 (nointegritychecks)...\n"
msgstr "\n[Uruchom] Przywracanie wymuszania podpisów (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已恢復正常，請重新開機以生效。\n"
msgstr "[OK] Przywrócono wymuszanie podpisów. Uruchom ponownie, aby zastosować.\n"

msgid "\n[執行] 正在恢復系統安全防護...\n"
msgstr "\n[Uruchom] Przywracanie zabezpieczeń systemu...\n"

msgid "  [錯誤] 關閉 nointegritychecks 失敗: {}\n"
msgstr "  [Błąd] Wyłączenie nointegritychecks nie powiodło się: {}\n"

msgid "  - 驅動強制簽章已恢復\n"
msgstr "  - Przywrócono wymuszanie podpisów sterowników\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [Błąd] Wyłączenie testsigning nie powiodło się: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [Błąd] Zapis do rejestru nie powiódł się (kod {}): Nie można włączyć integralności pamięci\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - Integralność pamięci włączona\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - Tryb testowy wyłączony\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - Bezpieczeństwo systemu przywrócone\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Błąd] Zapis do rejestru nie powiódł się (kod błędu {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Ostrzeżenie] Wystąpiły błędy. Sprawdź powyższy dziennik.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[OK] Zabezpieczenia przywrócone. Uruchom ponownie, aby zastosować.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Uruchom] Wyłączanie ograniczeń sterowników i jądra...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Błąd] Włączenie nointegritychecks nie powiodło się: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Wymuszanie podpisów sterowników wyłączone\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Błąd] Zapis do rejestru nie powiódł się (kod {}): Nie można wyłączyć integralności pamięci\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Integralność pamięci wyłączona\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Błąd] Włączenie testsigning nie powiodło się: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Tryb testowy włączony\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Lista blokowanych sterowników wyłączona\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[OK] Ograniczenia bezpieczeństwa zniesione. Uruchom ponownie, aby zastosować.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "Podłączono napęd/dysk USB: {} {}"

msgid "移除了隨身碟/磁碟: {} {}"
msgstr "Odłączono napęd/dysk USB: {} {}"

msgid "未偵測到包含 PE 環境的隨身碟"
msgstr "Nie wykryto dysku USB ze środowiskiem PE"

msgid "未插入任何隨身碟"
msgstr "Brak podłączonych dysków USB"

msgid "USB啟動"
msgstr "Rozruch z USB"

msgid "\n[狀態變更] {}\n"
msgstr "\n[Zmiana stanu] {}\n"

msgid "使用者將目標隨身碟切換為: {} {}"
