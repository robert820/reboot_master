msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Operacja: {}\n  Szczegóły: {}\n  Stan: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Brak historii aktywności.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Nie można uzyskać uprawnienia systemowego SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Zamykanie nie powiodło się, kod błędu: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Nie można uzyskać uprawnienia do ponownego uruchomienia SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Ponowne uruchomienie nie powiodło się, kod błędu: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Nie można uzyskać SeSystemEnvironmentPrivilege. Uruchom jako administrator"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Płyta główna lub system operacyjny nie obsługuje bezpośredniego restartu do BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Zapis zmiennej UEFI nie powiódł się. Zablokowany przez antywirus lub brak uprawnień."

msgid "重啟至 BIOS/UEFI"
msgstr "Uruchom ponownie do BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Zapisano zmienną UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 ustawiony na 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Przygotowywanie do ponownego uruchomienia"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Zmienna UEFI zapisana pomyślnie. Ponowne uruchamianie do BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Uruchomienie bcdedit nie powiodło się: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` nie powiodło się: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Nie znaleziono gałęzi rejestru SOFTWARE systemu fizycznego"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Nie znaleziono początku nowego identyfikatora GUID w wynikach bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Nie znaleziono końca nowego identyfikatora GUID w wynikach bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Nie można uzyskać bieżącej ścieżki pliku wykonywalnego: {}"

msgid "一次性安全模式"
msgstr "Jednorazowy tryb awaryjny"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Tryb: {}\n  Tymczasowy GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Jednorazowy tryb awaryjny został skonfigurowany. Ponowne uruchamianie..."

msgid "重啟至進階開機選單"
msgstr "Uruchom ponownie do zaawansowanych opcji rozruchu"

msgid "建立臨時副本 GUID: {}"
msgstr "Utworzono tymczasowy GUID wpisu: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Skonfigurowano jednorazowe zaawansowane opcje rozruchu. Restart..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Uruchom ponownie do oprogramowania układowego BIOS/UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Natychmiast uruchamia ponownie komputer i wchodzi do ustawień BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Jednorazowy tryb awaryjny (minimalny)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Jednorazowy rozruch w trybie awaryjnym. Powrót do trybu normalnego przy następnym restarcie."

msgid "一次性安全模式 (含網路)"
msgstr "Jednorazowy tryb awaryjny (z obsługą sieci)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Jednorazowy rozruch w trybie awaryjnym z siecią. Powrót do trybu normalnego przy następnym restarcie."

msgid "重啟進入進階開機選單"
msgstr "Uruchom ponownie do zaawansowanych opcji rozruchu"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Ponownie uruchamia komputer i bezpośrednio otwiera menu zaawansowanego rozruchu Windows."

msgid "直接強制重啟電腦"
msgstr "Wymuś natychmiastowy restart"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Natychmiast uruchamia ponownie komputer przy użyciu natywnego Win32 API."

msgid "直接安全關機"
msgstr "Bezpieczne zamknięcie teraz"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Natychmiast wyłącza komputer przy użyciu natywnego Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Włącz tryb testowy"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "System zaakceptuje sterowniki z podpisem testowym. Na pulpicie pojawi się znak wodny „Tryb testowy”.\n\n• Najpierw należy wyłączyć Secure Boot w BIOS-ie\n• Większość systemów anti-cheat (EAC, BattlEye) zablokuje gry w tym trybie\n• Wymagany restart. Użyj „Wyłącz tryb testowy”, aby wyłączyć"

msgid "關閉測試模式"
msgstr "Wyłącz tryb testowy"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Wyłączenie trybu testowego przywraca standardową weryfikację podpisów sterowników. Wymagany restart."

msgid "停用驅動程式強制簽章"
msgstr "Wyłącz wymuszanie podpisów sterowników"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Całkowicie wyłącza weryfikację podpisu sterowników Windows (nointegritychecks).\n\n• Umożliwia instalację niepodpisanych sterowników\n• Bezpieczeństwo systemu zostanie znacznie obniżone\n• Należy najpierw wyłączyć Secure Boot w BIOS-ie\n• Wymagany restart."

msgid "恢復強制簽章驗證"
msgstr "Przywróć wymuszanie podpisów"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Przywraca domyślną weryfikację podpisów sterowników Windows. Wymagany restart."

msgid "恢復系統安全防護"
msgstr "Przywróć bezpieczeństwo systemu"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Przywraca domyślną weryfikację podpisów i zabezpieczenia jądra Windows.\n\nWymagany restart, aby zastosować. Czy chcesz kontynuować?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ostrzeżenie: Wyłącza wymuszanie podpisów sterowników i integralność pamięci, znacznie obniżając bezpieczeństwo.\n\nWymagany restart, aby zastosować. Kontynuować?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ostrzeżenie: Włącza tryb testowy, zezwalając na ładowanie niepodpisanych sterowników, co obniża bezpieczeństwo.\n\nWymagany restart. Kontynuować?"

msgid "解除驅動與核心安全限制"
msgstr "Wyłącz ograniczenia sterowników i jądra"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Uruchom] Żądanie ponownego uruchomienia do BIOS/UEFI...\n"

