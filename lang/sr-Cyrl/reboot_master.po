msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Радња: {}\n  Детаљи: {}\n  Статус: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Још нема историје активности.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Није могуће добити системску привилегију SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Искључивање није успело, кôд грешке: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Није могуће добити привилегију поновног покретања SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Поновно покретање није успело, кôд грешке: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Није могуће добити SeSystemEnvironmentPrivilege. Покрените као администратор"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Матична плоча или ОС не подржава директно поновно покретање у БИОС/фирмвер"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Уписивање UEFI променљиве није успело. Блокирано антивирусом или дозволама."

msgid "重啟至 BIOS/UEFI"
msgstr "Поново покрени у BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Уписана UEFI променљива: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Бит 0 постављен на 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Припрема за поновно покретање"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "UEFI променљива је успешно уписана. Поновно покретање у BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Покретање bcdedit није успело: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` није успео: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Није пронађена SOFTWARE кошница регистра физичког система"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Није пронађен почетак новог GUID-а у bcdedit излазу"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Није пронађен крај новог GUID-а у bcdedit излазу"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Није могуће добити путању тренутне извршне датотеке: {}"

msgid "一次性安全模式"
msgstr "Једнократни безбедни режим"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Режим: {}\n  Привремени GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Једнократни безбедни режим је подешен. Поновно покретање..."

msgid "重啟至進階開機選單"
msgstr "Поново покрени у напредни мени покретања"

msgid "建立臨時副本 GUID: {}"
msgstr "Креиран привремени GUID уноса: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Једнократне напредне опције покретања су подешене. Поновно покретање..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Поново покрени у БИОС / UEFI фирмвер"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Одмах поново покреће рачунар и аутоматски улази у BIOS/UEFI подешавања."

msgid "一次性安全模式 (Minimal)"
msgstr "Једнократни безбедни режим (минимални)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Покреће се у безбедном режиму једном. Враћа се у нормални режим при следећем покретању."

msgid "一次性安全模式 (含網路)"
msgstr "Једнократни безбедни режим (са мрежом)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Покреће се у безбедном режиму са мрежом једном. Враћа се у нормалу при следећем покретању."

msgid "重啟進入進階開機選單"
msgstr "Поново покрени у напредне опције покретања"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Поново покреће рачунар и отвара Windows мени за напредно покретање и решавање проблема."

msgid "直接強制重啟電腦"
msgstr "Принудно поново покрени"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Одмах поново покреће рачунар користећи изворни Win32 API."

msgid "直接安全關機"
msgstr "Безбедно искључи одмах"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Одмах искључује рачунар користећи изворни Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Омогући режим тестирања"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Систем ће прихватити драјвере са тестним потписом. Појавиће се водени жиг „Режим тестирања”.\n\n• Secure Boot мора прво бити искључен у BIOS-у\n• Већина anti-cheat система (EAC, BattlEye) блокираће игре\n• Потребно је поновно покретање. Изаберите „Онемогући режим тестирања” за искључивање"

msgid "關閉測試模式"
msgstr "Онемогући режим тестирања"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Онемогућавање режима тестирања враћа стандардну проверу потписа драјвера. Потребно је поновно покретање."

msgid "停用驅動程式強制簽章"
msgstr "Онемогући принудно потписивање драјвера"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Потпуно искључује проверу потписа драјвера у Windows-у (nointegritychecks).\n\n• Омогућава инсталацију непотписаних драјвера\n• Безбедност система ће бити значајно умањена\n• Secure Boot мора прво бити искључен у BIOS-у\n• Потребно је поновно покретање."

msgid "恢復強制簽章驗證"
msgstr "Врати принудно потписивање"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Враћа подразумевану Windows верификацију потписа драјвера. Потребно је поновно покретање."

msgid "恢復系統安全防護"
msgstr "Врати безбедност система"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Вратиће подразумевану верификацију потписа и безбедност кернела.\n\nПотребно је поновно покретање. Желите ли да наставите?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Упозорење: Онемогућава принудно потписивање драјвера и искључује интегритет меморије, знатно смањујући безбедност.\n\nПотребно је поновно покретање. Наставити?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Упозорење: Омогућава режим тестирања за учитавање непотписаних драјвера, знатно смањујући безбедност.\n\nПотребно је поновно покретање. Наставити?"

msgid "解除驅動與核心安全限制"
msgstr "Укини ограничења драјвера и кернела"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Покрени] Захтева се поновно покретање у BIOS/UEFI...\n"

