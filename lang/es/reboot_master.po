msgstr "Error al reiniciar, código de error: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "No se puede obtener SeSystemEnvironmentPrivilege. Ejecute como administrador"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "La placa base o el SO no admiten reiniciar directamente al firmware/BIOS"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Error al escribir la variable UEFI. Bloqueado por antivirus o permisos."

msgid "重啟至 BIOS/UEFI"
msgstr "Reiniciar en BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Variable UEFI escrita: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 establecido en 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Preparando para reiniciar"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Variable UEFI escrita con éxito. Reiniciando en BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Error al ejecutar bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` falló: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "No se encontró la colmena del Registro SOFTWARE del sistema físico"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "No se encontró el inicio del nuevo GUID en la salida de bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "No se encontró el final del nuevo GUID en la salida de bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "No se puede obtener la ruta del ejecutable actual: {}"

msgid "一次性安全模式"
msgstr "Modo seguro de una sola vez"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Modo: {}\n  GUID temporal: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Modo seguro de una sola vez configurado con éxito. Reiniciando..."

msgid "重啟至進階開機選單"
msgstr "Reiniciar en opciones de inicio avanzadas"

msgid "建立臨時副本 GUID: {}"
msgstr "GUID de entrada temporal creado: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Opciones de inicio avanzadas configuradas. Reiniciando..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Reiniciar en firmware BIOS/UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Reinicia el equipo de inmediato y entra automáticamente en la configuración BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Modo seguro de una sola vez (mínimo)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Arranca en modo seguro una vez. Vuelve al modo normal en el siguiente reinicio."

msgid "一次性安全模式 (含網路)"
msgstr "Modo seguro de una sola vez (con funciones de red)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Arranca en modo seguro con red una vez. Vuelve al modo normal en el siguiente reinicio."

msgid "重啟進入進階開機選單"
msgstr "Reiniciar en opciones de inicio avanzadas"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Reinicia el equipo y abre el menú de inicio avanzado y solución de problemas de Windows."

msgid "直接強制重啟電腦"
msgstr "Forzar reinicio ahora"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Reinicia su equipo inmediatamente mediante la API nativa de Win32."

msgid "直接安全關機"
msgstr "Apagado seguro ahora"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Apaga su equipo inmediatamente mediante la API nativa de Win32."

msgid "開啟測試模式 (Test Mode)"
msgstr "Habilitar modo de prueba"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "El sistema aceptará controladores con firma de prueba. Aparecerá la marca de agua \"Modo de prueba\".\n\n• Secure Boot debe desactivarse primero en el BIOS\n• La mayoría de anti-trampas (EAC, BattlEye) bloquearán juegos en este modo\n• Se requiere reiniciar. Use \"Deshabilitar modo de prueba\" para apagarlo"

msgid "關閉測試模式"
msgstr "Deshabilitar modo de prueba"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Deshabilitar el modo de prueba restaura la comprobación estándar de firmas de controladores. Reinicio requerido."

msgid "停用驅動程式強制簽章"
msgstr "Deshabilitar el uso obligatorio de controladores firmados"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Desactiva por completo la comprobación de firmas de controladores de Windows (nointegritychecks).\n\n• Permite instalar controladores sin firmar\n• La seguridad del sistema se reducirá considerablemente\n• Secure Boot debe desactivarse primero en el BIOS\n• Se requiere reiniciar."

msgid "恢復強制簽章驗證"
msgstr "Restaurar obligatoriedad de firmas"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Restaurará el mecanismo predeterminado de verificación de firmas de Windows. Reinicio requerido."

msgid "恢復系統安全防護"
msgstr "Restaurar seguridad del sistema"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Restaurará la comprobación de firmas y la seguridad del kernel de Windows.\n\nSe requiere reiniciar para aplicar los cambios. ¿Continuar?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Advertencia: Deshabilita la firma obligatoria de controladores y la integridad de memoria, reduciendo la seguridad.\n\nSe requiere reiniciar para aplicar los cambios. ¿Continuar?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Advertencia: Habilita el modo de prueba para cargar controladores sin firmar, reduciendo la seguridad.\n\nSe requiere reiniciar. ¿Continuar?"

msgid "解除驅動與核心安全限制"
msgstr "Desactivar restricciones de controladores y kernel"

