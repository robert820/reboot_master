msgstr "Диски USB бо муҳити PE ошкор нашуд"

msgid "未插入任何隨身碟"
msgstr "Ҳеҷ диски USB пайваст нашудааст"

msgid "USB啟動"
msgstr "Боркунӣ аз USB"

msgid "\n[狀態變更] {}\n"
msgstr "\n[Тағйири ҳолат] {}\n"

msgid "使用者將目標隨身碟切換為: {} {}"
msgstr "Диски USB-и ҳадаф иваз шуд ба: {} {}"

