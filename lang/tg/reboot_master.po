msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Амал: {}\n  Тафсилот: {}\n  Ҳолат: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "То ҳол таърихи фаъолият нест.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Гирифтани имтиёзи системавии SeShutdownPrivilege номумкин аст"

msgid "關機失敗，錯誤碼: {}"
msgstr "Хомӯшкунӣ ноком шуд, рамзи хато: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Гирифтани имтиёзи бозоғозии SeShutdownPrivilege номумкин аст"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Бозоғозӣ ноком шуд, рамзи хато: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Гирифтани SeSystemEnvironmentPrivilege номумкин аст. Лутфан ҳамчун администратор иҷро кунед"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Модарплата ё ОС бозоғозии мустақим ба танзимоти BIOS/UEFI-ро дастгирӣ намекунад"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Сабти тағйирёбандаи UEFI ноком шуд. Аз ҷониби антивирус ё иҷозатҳо баста шудааст."

msgid "重啟至 BIOS/UEFI"
msgstr "Бозоғозӣ ба BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Тағйирёбандаи UEFI навишта шуд: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Бит 0 ба 1 гузошта шуд (BootToFwUI)"

msgid "準備重啟"
msgstr "Омодагӣ ба бозоғозӣ"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Тағйирёбандаи UEFI бомуваффақият сабт шуд. Бозоғозӣ ба BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Иҷрои bcdedit ноком шуд: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` ноком шуд: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Шохаи феҳристи SOFTWARE-и системаи физикӣ ёфт нашуд"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Оғози GUID-и нав дар баромади bcdedit ёфт нашуд"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Охири GUID-и нав дар баромади bcdedit ёфт нашуд"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Роҳи файли иҷрошавандаи ҷорӣ ба даст наомад: {}"

msgid "一次性安全模式"
msgstr "Ҳолати бехатари яквақта"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Реҷа: {}\n  GUID-и муваққатӣ: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Ҳолати бехатари яквақта танзим шуд. Бозоғозӣ дар ҳоли иҷро..."

msgid "重啟至進階開機選單"
msgstr "Бозоғозӣ ба менюи пешрафтаи боркунӣ"

msgid "建立臨時副本 GUID: {}"
msgstr "GUID-и сабти муваққатӣ сохта шуд: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Имконоти пешрафтаи боркунии яквақта танзим шуданд. Бозоғозӣ..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Бозоғозӣ ба нармафзори BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Компютерро фавран бозоғоз намуда, ба таври худкор ба танзимоти BIOS/UEFI ворид мешавад."

msgid "一次性安全模式 (Minimal)"
msgstr "Ҳолати бехатари яквақта (минималӣ)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Як бор ба ҳолати бехатар ворид мешавад. Дар бозоғозии навбатӣ ба ҳолати муқаррарӣ бармегардад."

msgid "一次性安全模式 (含網路)"
msgstr "Ҳолати бехатари яквақта (бо шабака)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Як бор ба ҳолати бехатар бо шабака ворид мешавад. Дар бозоғозии баъдӣ ба ҳолати муқаррарӣ бармегардад."

msgid "重啟進入進階開機選單"
msgstr "Бозоғозӣ ба имконоти пешрафтаи боркунӣ"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Компютерро бозоғоз мекунад ва менюи оғози пешрафта ва бартарафсозии мушкилотро мекушояд."

msgid "直接強制重啟電腦"
msgstr "Бозоғозии маҷбурӣ ҳоло"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Компютери шуморо фавран тавассути API-и маҳаллии Win32 бозоғоз мекунад."

msgid "直接安全關機"
msgstr "Хомӯшкунии бехатар ҳоло"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Компютери шуморо фавран тавассути API-и маҳаллии Win32 хомӯш мекунад."

msgid "開啟測試模式 (Test Mode)"
msgstr "Фаъол кардани ҳолати санҷиш"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Система драйверҳои санҷиширо қабул мекунад. Нишонаи обии \"Ҳолати санҷиш\" дар мизи корӣ пайдо мешавад.\n\n• Аввал Secure Boot дар BIOS бояд хомӯш карда шавад\n• Аксари системаҳои зидди фиреб (EAC, BattlEye) бозиҳоро манъ мекунанд\n• Барои эътибор пайдо кардан бозоғозӣ лозим аст"

msgid "關閉測試模式"
msgstr "Хомӯш кардани ҳолати санҷиш"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Хомӯш кардани ҳолати санҷиш тафтиши стандартии имзои драйверҳоро барқарор мекунад. Бозоғозӣ лозим аст."

msgid "停用驅動程式強制簽章"
msgstr "Хомӯш кардани маҷбурияти имзои драйвер"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Санҷиши имзои драйверҳои Windows-ро комилан хомӯш мекунад (nointegritychecks).\n\n• Насби драйверҳои беимзоро иҷозат медиҳад\n• Амнияти система ба таври назаррас коҳиш меёбад\n• Secure Boot бояд аввал дар BIOS хомӯш карда шавад\n• Бозоғозӣ лозим аст."

msgid "恢復強制簽章驗證"
msgstr "Барқарор кардани маҷбурияти имзо"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Механизми пешфарзи санҷиши имзои драйверҳои Windows-ро барқарор мекунад. Бозоғозӣ лозим аст."

msgid "恢復系統安全防護"
msgstr "Барқарор кардани амнияти система"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Санҷиши пешфарзи имзо ва амнияти ядрои Windows-ро барқарор мекунад.\n\nБарои пурра эътибор пайдо кардан бозоғозӣ лозим аст. Идома медиҳед?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Огоҳӣ: Иҷрои имзои драйверҳо ва беайбии хотира хомӯш карда шуда, амнияти система ба таври назаррас коҳиш меёбад.\n\nБозоғозӣ лозим аст. Идома медиҳед?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Огоҳӣ: Ҳолати санҷишро фаъол мекунад, то боркунии драйверҳои беимзо иҷозат дода шавад, ки амниятро коҳиш медиҳад.\n\nБозоғозӣ лозим аст. Идома медиҳед?"

msgid "解除驅動與核心安全限制"
msgstr "Лағви маҳдудиятҳои амнияти драйвер ва ядро"

