msgstr "\n[ดำเนินการ] กำลังปิดเครื่องผ่าน Native Win32 ExitWindowsEx API...\n"

msgid "[成功] 已發送 Win32 原生關機信號，系統正在關機...\n"
msgstr "[สำเร็จ] ส่งสัญญาณปิดเครื่อง Native Win32 แล้ว กำลังปิดเครื่อง...\n"

msgid "\n[執行] 正在開啟測試模式...\n"
msgstr "\n[ดำเนินการ] กำลังเปิดใช้งานโหมดทดสอบ...\n"

msgid "[成功] 測試模式已開啟，請重新開機以生效。桌面右下角將顯示「測試模式」浮水印。\n"
msgstr "[สำเร็จ] เปิดโหมดทดสอบแล้ว โปรดรีสตาร์ทเพื่อให้มีผล ลายน้ำจะปรากฏบนเดสก์ท็อป\n"

msgid "[錯誤] {}\n提示：請先到 BIOS 關閉 Secure Boot 後再嘗試。\n"
msgstr "[ข้อผิดพลาด] {}\nคำแนะนำ: โปรดปิด Secure Boot ใน BIOS แล้วลองใหม่อีกครั้ง\n"

msgid "\n[執行] 正在關閉測試模式...\n"
msgstr "\n[ดำเนินการ] กำลังปิดใช้งานโหมดทดสอบ...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[สำเร็จ] ปิดใช้งานโหมดทดสอบแล้ว โปรดรีสตาร์ทเพื่อให้มีผล\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[ดำเนินการ] กำลังปิดการบังคับใช้ลายเซ็น (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已停用，請重新開機以生效。\n"
msgstr "[สำเร็จ] ปิดใช้งานการบังคับใช้ลายเซ็นแล้ว โปรดรีสตาร์ทเพื่อให้มีผล\n"

msgid "[錯誤] {}\n提示：請確認是否具備系統管理員權限，或先到 BIOS 關閉 Secure Boot。\n"
msgstr "[ข้อผิดพลาด] {}\nคำแนะนำ: โปรดตรวจสอบสิทธิ์ผู้ดูแลระบบ หรือปิด Secure Boot ใน BIOS\n"

msgid "\n[執行] 正在恢復強制簽章 (nointegritychecks)...\n"
msgstr "\n[ดำเนินการ] กำลังคืนค่าการบังคับใช้ลายเซ็น (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已恢復正常，請重新開機以生效。\n"
msgstr "[สำเร็จ] คืนค่าการบังคับใช้ลายเซ็นแล้ว โปรดรีสตาร์ทเพื่อให้มีผล\n"

msgid "\n[執行] 正在恢復系統安全防護...\n"
msgstr "\n[ดำเนินการ] กำลังคืนค่าความปลอดภัยของระบบ...\n"

msgid "  [錯誤] 關閉 nointegritychecks 失敗: {}\n"
msgstr "  [ข้อผิดพลาด] ปิด nointegritychecks ล้มเหลว: {}\n"

msgid "  - 驅動強制簽章已恢復\n"
msgstr "  - คืนค่าการบังคับใช้ลายเซ็นไดรเวอร์แล้ว\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [ข้อผิดพลาด] ปิด testsigning ล้มเหลว: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [ข้อผิดพลาด] เขียนรีจิสทรีล้มเหลว (รหัส {}): ไม่สามารถเปิดใช้งานความสมบูรณ์ของหน่วยความจำ\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - เปิดใช้งานความสมบูรณ์ของหน่วยความจำแล้ว\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - ปิดใช้งานโหมดทดสอบแล้ว\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - คืนค่าความปลอดภัยของระบบแล้ว\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
