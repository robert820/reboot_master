msgstr "[{}] การดำเนินการ: {}\n  รายละเอียด: {}\n  สถานะ: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "ยังไม่มีประวัติกิจกรรม\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "ไม่สามารถรับสิทธิ์ระบบ SeShutdownPrivilege ได้"

msgid "關機失敗，錯誤碼: {}"
msgstr "การปิดระบบล้มเหลว รหัสข้อผิดพลาด: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "ไม่สามารถรับสิทธิ์การรีสตาร์ท SeShutdownPrivilege ได้"

msgid "重啟失敗，錯誤碼: {}"
msgstr "การรีสตาร์ทล้มเหลว รหัสข้อผิดพลาด: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "ไม่สามารถรับสิทธิ์ SeSystemEnvironmentPrivilege ได้ โปรดเรียกใช้ในฐานะผู้ดูแลระบบ"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "เมนบอร์ดหรือระบบปฏิบัติการไม่รองรับการรีสตาร์ทไปยัง BIOS/UEFI โดยตรง"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "เขียนตัวแปร UEFI ล้มเหลว อาจถูกบล็อกโดยโปรแกรมป้องกันไวรัสหรือสิทธิ์การใช้งาน"

msgid "重啟至 BIOS/UEFI"
msgstr "รีสตาร์ทไปยัง BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "เขียนตัวแปร UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), ตั้งค่า Bit 0 เป็น 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "กำลังเตรียมรีสตาร์ท"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "เขียนตัวแปร UEFI สำเร็จแล้ว กำลังรีสตาร์ทไปยัง BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "เรียกใช้ bcdedit ล้มเหลว: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` ล้มเหลว: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "ไม่พบไฮฟ์รีจิสทรี SOFTWARE ของระบบจริง"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "ไม่พบจุดเริ่มต้นของ GUID ใหม่ในเอาต์พุต bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "ไม่พบจุดสิ้นสุดของ GUID ใหม่ในเอาต์พุต bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "ไม่สามารถรับเส้นทางไฟล์เรียกทำงานปัจจุบันได้: {}"

msgid "一次性安全模式"
msgstr "Safe Mode ครั้งเดียว"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "โหมด: {}\n  GUID ชั่วคราว: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "กำหนดค่า Safe Mode ครั้งเดียวสำเร็จแล้ว กำลังรีสตาร์ท..."

msgid "重啟至進階開機選單"
msgstr "รีสตาร์ทไปยังเมนูการบูตขั้นสูง"

msgid "建立臨時副本 GUID: {}"
msgstr "สร้าง GUID รายการชั่วคราวแล้ว: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "กำหนดค่าตัวเลือกการบูตขั้นสูงครั้งเดียวสำเร็จแล้ว กำลังรีสตาร์ท..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "รีสตาร์ทไปยังเฟิร์มแวร์ BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "รีสตาร์ทคอมพิวเตอร์ทันทีและเข้าสู่หน้าจอการตั้งค่า BIOS/UEFI โดยอัตโนมัติ"

msgid "一次性安全模式 (Minimal)"
msgstr "Safe Mode ครั้งเดียว (พื้นฐาน)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "บูตเข้าสู่ Safe Mode หนึ่งครั้ง และจะกลับสู่โหมดปกติในการรีสตาร์ทครั้งถัดไป"

msgid "一次性安全模式 (含網路)"
msgstr "Safe Mode ครั้งเดียว (พร้อมเครือข่าย)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "บูตเข้าสู่ Safe Mode พร้อมเครือข่ายหนึ่งครั้ง และจะกลับสู่โหมดปกติในการรีสตาร์ทครั้งถัดไป"

msgid "重啟進入進階開機選單"
msgstr "รีสตาร์ทไปยังตัวเลือกการเริ่มต้นขั้นสูง"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "รีสตาร์ทคอมพิวเตอร์และเปิดเมนูการเริ่มต้นขั้นสูงและการแก้ไขปัญหาของ Windows"

msgid "直接強制重啟電腦"
msgstr "บังคับรีสตาร์ททันที"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "รีสตาร์ทคอมพิวเตอร์ของคุณทันทีผ่าน Win32 Native API"

msgid "直接安全關機"
msgstr "ปิดเครื่องอย่างปลอดภัยทันที"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "ปิดเครื่องคอมพิวเตอร์ของคุณทันทีผ่าน Win32 Native API"

msgid "開啟測試模式 (Test Mode)"
msgstr "เปิดใช้งานโหมดทดสอบ"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "ระบบจะยอมรับไดรเวอร์ที่ลงนามทดสอบ ลายน้ำ \"Test Mode\" จะปรากฏบนเดสก์ท็อป\n\n• ต้องปิด Secure Boot ใน BIOS ก่อน\n• ระบบป้องกันการโกงส่วนใหญ่ (EAC, BattlEye) จะปฏิเสธการเล่นเกมในโหมดนี้\n• จำเป็นต้องรีสตาร์ท ใช้ \"ปิดใช้งานโหมดทดสอบ\" เพื่อปิด"

msgid "關閉測試模式"
msgstr "ปิดใช้งานโหมดทดสอบ"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "การปิดใช้งานโหมดทดสอบจะคืนค่าการตรวจสอบลายเซ็นไดรเวอร์มาตรฐาน จำเป็นต้องรีสตาร์ท"

msgid "停用驅動程式強制簽章"
msgstr "ปิดใช้งานการบังคับใช้ลายเซ็นไดรเวอร์"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "ปิดการตรวจสอบลายเซ็นดิจิทัลของไดรเวอร์ Windows โดยสมบูรณ์ (nointegritychecks)\n\n• อนุญาตให้ติดตั้งไดรเวอร์ที่ไม่มีลายเซ็น\n• ความปลอดภัยของระบบจะลดลงอย่างมาก\n• ต้องปิด Secure Boot ใน BIOS ก่อน\n• จำเป็นต้องรีสตาร์ทเพื่อให้มีผล"

msgid "恢復強制簽章驗證"
msgstr "คืนค่าการบังคับใช้ลายเซ็น"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "จะคืนค่ากลไกการตรวจสอบลายเซ็นดิจิทัลเริ่มต้นของ Windows จำเป็นต้องรีสตาร์ท"

msgid "恢復系統安全防護"
msgstr "คืนค่าความปลอดภัยของระบบ"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "จะคืนค่าการตรวจสอบลายเซ็นดิจิทัลและความปลอดภัยของเคอร์เนลตามค่าเริ่มต้น\n\nจำเป็นต้องรีสตาร์ทเพื่อให้มีผลสมบูรณ์ ยืนยันที่จะดำเนินการหรือไม่"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "คำเตือน: การดำเนินการนี้จะปิดการบังคับใช้ลายเซ็นไดรเวอร์และปิดความสมบูรณ์ของหน่วยความจำ ซึ่งลดความปลอดภัยลงอย่างมาก\n\nจำเป็นต้องรีสตาร์ทเพื่อนำไปใช้ ดำเนินการต่อหรือไม่"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "คำเตือน: การเปิดโหมดทดสอบเพื่ออนุญาตให้โหลดไดรเวอร์ที่ไม่ได้ลงนาม จะลดความปลอดภัยของระบบลงอย่างมาก\n\nจำเป็นต้องรีสตาร์ทเพื่อนำไปใช้ ดำเนินการต่อหรือไม่"

msgid "解除驅動與核心安全限制"
msgstr "ปลดล็อกข้อจำกัดความปลอดภัยของไดรเวอร์และเคอร์เนล"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[ดำเนินการ] กำลังร้องขอการรีสตาร์ทไปยัง BIOS/UEFI...\n"

