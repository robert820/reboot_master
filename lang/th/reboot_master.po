msgstr "ไม่สามารถเชื่อมต่อกับ GitHub ได้ โปรดตรวจสอบการเชื่อมต่อเครือข่าย"

msgid "正在下載更新，完成後將自動重新啟動..."
msgstr "กำลังดาวน์โหลดอัปเดต แอปจะรีสตาร์ทโดยอัตโนมัติเมื่อเสร็จสิ้น..."

msgid "尚未檢查更新。"
msgstr "ยังไม่ได้ตรวจสอบการอัปเดต"

msgid "檢查更新"
msgstr "ตรวจหาการอัปเดต"

msgid "立即更新"
msgstr "อัปเดตทันที"

msgid "再次確認您的操作"
msgstr "ยืนยันการดำเนินการ"

msgid "\n\n請確認您的所有工作與文件皆已儲存。確定要立即執行嗎？"
msgstr "\n\nโปรดตรวจสอบว่าได้บันทึกงานและเอกสารทั้งหมดแล้ว ยืนยันที่จะดำเนินการทันทีหรือไม่"

msgid "取消"
msgstr "ยกเลิก"

msgid "確定執行"
msgstr "ยืนยัน"

msgid "所有安全模式均採用無痕自動清除技術，重啟後將自動還原。"
msgstr "Safe Mode ทั้งหมดใช้ระบบล้างข้อมูลอัตโนมัติ และจะคืนค่าเดิมหลังรีสตาร์ท"

msgid "恢復預設數位簽章驗證與防護。"
msgstr "คืนค่าการตรวจสอบลายเซ็นดิจิทัลและการป้องกันเริ่มต้น"

msgid "關閉數位簽章驗證與記憶體完整性"
msgstr "ปิดการตรวจสอบลายเซ็นดิจิทัลและความสมบูรณ์ของหน่วยความจำ"

msgid "允許載入無簽章之驅動程式。"
msgstr "อนุญาตให้โหลดไดรเวอร์ที่ไม่ได้ลงนาม"

msgid "選擇語言"
msgstr "เลือกภาษา"

msgid "此功能僅支援 Windows 8 及以上版本。您的系統過舊，請在開機時手動按鍵進入 BIOS。"
msgstr "ฟังก์ชันนี้รองรับเฉพาะ Windows 8 ขึ้นไป โปรดกดปุ่มลัดระหว่างบูตเครื่องเพื่อเข้าสู่ BIOS ด้วยตนเอง"

msgid "此系統為傳統 BIOS (Legacy)，無法透過軟體重啟進入 BIOS 設定。請在開機時手動按鍵進入。"
msgstr "ระบบนี้เป็น Legacy BIOS จึงไม่สามารถรีสตาร์ทเข้า BIOS ผ่านซอฟต์แวร์ได้ โปรดกดปุ่มขณะเปิดเครื่อง"

msgid "  [範本解析] 處於 WinPE 環境，採用實體系統預設項 {default}\n"
msgstr "[เทมเพลต] ในสภาพแวดล้อม WinPE โดยใช้รายการเริ่มต้นระบบปฏิบัติการจริง {default} \n"

msgid "  [範本解析] 正在探測當前引導項 {current}...\n"
msgstr "[เทมเพลต] กำลังตรวจสอบรายการบูตปัจจุบัน {current}... \n"

msgid "  [範本解析] 當前會話引導項 {current} 有效，採用為母體範本\n"
msgstr "[เทมเพลต] รายการบูตปัจจุบัน {current} ถูกต้อง ใช้เป็นเทมเพลตฐาน \n"

msgid "  [範本解析] 偵測到 {current} 已於前次重啟後被清理刪除 (無效識別元)\n"
msgstr "[เทมเพลต] ตรวจพบ {current} ได้รับการล้างข้อมูลหลังจากการรีบูตครั้งก่อน (ตัวระบุที่ไม่ถูกต้อง) \n"

msgid "  [範本解析] 正在驗證系統永久開機項 {default}...\n"
msgstr "[เทมเพลต] กำลังตรวจสอบรายการบูตระบบถาวร {default}... \n"

msgid "  [範本解析] 成功選定系統永久開機項 {default} 作為母體範本 (確保一次成功)\n"
msgstr "[เทมเพลต] เลือกรายการถาวร {default} เป็นเทมเพลตฐานสำเร็จแล้ว (รับประกันความสำเร็จในการลองครั้งแรก) \n"

msgid "  [範本解析] 正在掃描 BCD osloader 列表以尋找有效開機項...\n"
msgstr "[เทมเพลต] กำลังสแกนรายการ BCD osloader เพื่อหารายการบูตที่ถูกต้อง... \n"

msgid "  [範本解析] 從 osloader 列表成功定位實體系統項: {}\n"
msgstr "[เทมเพลต] ค้นหารายการระบบปฏิบัติการจริงจาก osloader ได้สำเร็จ: {} \n"

msgid "  [範本解析] 未能列舉額外開機項，預設採用 {default}\n"
msgstr "[เทมเพลต] ไม่สามารถระบุรายการเพิ่มเติมได้ โดยค่าเริ่มต้นเป็น {default} \n"

msgid "  [建立副本] 正在自範本 {} 複製建立臨時安全模式項...\n"
msgstr "[สร้างโคลน] กำลังคัดลอกเทมเพลต {} เพื่อสร้างรายการ Safe Mode ชั่วคราว... \n"

msgid "  [建立副本] 成功建立副本！\n"
msgstr "[สร้างโคลน] สร้างโคลนสำเร็จแล้ว! \n"

msgid "  [降級備援] 複製範本 {} 失敗: {}，啟動備援嘗試 {{default}}...\n"
msgstr "[ทางเลือกสำรอง] การคัดลอกเทมเพลต {} ล้มเหลว: {} กำลังพยายามใช้ทางเลือกสำรองด้วย {{default}}... \n"

msgid "  [降級備援] 備援方案複製 {default} 成功！\n"
msgstr "[ทางเลือกสำรอง] โคลนทางเลือกของ {default} สำเร็จแล้ว! \n"

msgid "  [降級備援] 備援方案亦失敗: {}\n"
msgstr "[ทางเลือก] การโคลนทางเลือกล้มเหลวเช่นกัน: {} \n"

msgid "建立臨時安全模式引導項失敗"
msgstr "ไม่สามารถสร้างรายการบูต Safe Mode ชั่วคราว"

msgid "  [建立副本] 失敗: {}\n"
msgstr "[สร้างโคลน] ล้มเหลว: {} \n"

msgid "  [臨時標識] 取得臨時 GUID: {}\n"
msgstr "[Temp GUID] ได้รับ GUID ชั่วคราว: {} \n"

msgid "  [選單隱藏] 從開機選單中隱藏此臨時副本 (/displayorder ... /remove)...\n"
msgstr "[ซ่อนเมนู] กำลังซ่อนโคลนชั่วคราวจากเมนูบูต (/displayorder ... /remove)... \n"

msgid "  [模式配置] 設定 safeboot 參數為 {}...\n"
msgstr "[Config] การตั้งค่าพารามิเตอร์ safeboot เป็น {}... \n"

msgid "  [一次性引導] 設定單次啟動序列 (/bootsequence)，重啟後 BootMgr 自動復原...\n"
msgstr "[การบูตครั้งเดียว] การตั้งค่าลำดับช็อตเดียว (/ bootsequence) BootMgr จะคืนค่าหลังจากรีสตาร์ท... \n"

msgid "  [開機自毀] 註冊 RunOnce 自毀清理任務 (重啟登入後徹底刪除臨時項目)...\n"
msgstr "[ทำลายตัวเอง] กำลังลงทะเบียนงานล้างข้อมูล RunOnce (ลบรายการชั่วคราวอย่างถาวรหลังจากเข้าสู่ระบบ)... \n"

msgid "母體範本: {}\n  模式: {}\n  臨時 GUID: {}"
msgstr "เทมเพลตฐาน: {}\nโหมด: {}\nTemp GUID: {}"

msgid "  [建立副本] 正在自範本 {} 複製建立臨時進階選單項...\n"
msgstr "[สร้างโคลน] กำลังคัดลอกเทมเพลต {} เพื่อสร้างรายการตัวเลือกการบูตขั้นสูงชั่วคราว... \n"

msgid "建立臨時進階選單引導項失敗"
msgstr "ไม่สามารถสร้างรายการบูตตัวเลือกการบูตขั้นสูงชั่วคราว"

msgid "  [進階選項] 啟用 advancedoptions=true (Win7 顯示 F8 選單，Win10/11 顯示開機設定)...\n"
msgstr "[ตัวเลือกขั้นสูง] เปิดใช้งานตัวเลือกขั้นสูง=true (เมนู F8 บน Win7, การตั้งค่าเริ่มต้นบน Win10/11)... \n"

msgid "母體範本: {}\n  臨時 GUID: {}"
msgstr "เทมเพลตฐาน: {}\nGUID ชั่วคราว: {}"

msgid "此功能僅支援 Windows 8 及以上之 UEFI 系統"
msgstr "คุณสมบัตินี้รองรับเฉพาะระบบ UEFI บน Windows 8 ขึ้นไป"

msgid "主機板或系統未支援韌體引導 (Legacy BIOS)"
msgstr "เมนบอร์ดหรือระบบไม่รองรับการบูตเฟิร์มแวร์ (Legacy BIOS)"

