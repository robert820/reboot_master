msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] פעולה: {}\n  פרטים: {}\n  סטטוס: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "אין עדיין היסטוריית פעילות.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "לא ניתן לקבל את הרשאת המערכת SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "הכיבוי נכשל, קוד שגיאה: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "לא ניתן לקבל את הרשאת ההפעלה מחדש SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "ההפעלה מחדש נכשלה, קוד שגיאה: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "לא ניתן לקבל את SeSystemEnvironmentPrivilege. ודא הפעלה כמנהל מערכת"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "לוח האם או מערכת ההפעלה אינם תומכים בהפעלה מחדש ישירה ל-BIOS/קושחה"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "כתיבת משתנה UEFI נכשלה. נחסם על ידי אנטי-וירוס או בעיית הרשאות."

msgid "重啟至 BIOS/UEFI"
msgstr "הפעל מחדש ל-BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "נכתב משתנה UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), ביט 0 הוגדר ל-1 (BootToFwUI)"

msgid "準備重啟"
msgstr "מתכונן להפעלה מחדש"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "משתנה UEFI נכתב בהצלחה. מפעיל מחדש ל-BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "הפעלת bcdedit נכשלה: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` נכשל: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "לא נמצא כוורת הרישום SOFTWARE של המערכת הפיזית"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "לא נמצאה תחילת ה-GUID החדש בפלט של bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "לא נמצא סוף ה-GUID החדש בפלט של bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "לא ניתן לקבל את נתיב קובץ ההפעלה הנוכחי: {}"

msgid "一次性安全模式"
msgstr "מצב בטוח חד-פעמי"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "מצב: {}\n  GUID זמני: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "מצב בטוח חד-פעמי הוגדר בהצלחה. המערכת מופעלת מחדש..."

msgid "重啟至進階開機選單"
msgstr "הפעל מחדש לאפשרויות אתחול מתקדמות"

msgid "建立臨時副本 GUID: {}"
msgstr "נוצר GUID זמני לרשומה: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "אפשרויות אתחול מתקדמות חד-פעמיות הוגדרו. המערכת מופעלת מחדש..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "הפעל מחדש לקושחת BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "מפעיל מחדש את המחשב מיד ונכנס אוטומטית להגדרות BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "מצב בטוח חד-פעמי (בסיסי)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "האתחול הבא יכנס למצב בטוח. חוזר למצב רגיל בהפעלה מחדש הבאה."

msgid "一次性安全模式 (含網路)"
msgstr "מצב בטוח חד-פעמי (עם רשת)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "האתחול הבא יכנס למצב בטוח עם רשת. חוזר למצב רגיל בהפעלה מחדש הבאה."

msgid "重啟進入進階開機選單"
msgstr "הפעל מחדש לאפשרויות אתחול מתקדמות"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "מפעיל מחדש את המחשב ופותח ישירות את תפריט האתחול המתקדם ופתרון הבעיות של Windows."

msgid "直接強制重啟電腦"
msgstr "אלץ הפעלה מחדש כעת"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "מפעיל מחדש את המחשב שלך באופן מיידי דרך Win32 API מקורי."

msgid "直接安全關機"
msgstr "כיבוי בטוח כעת"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "מכבה את המחשב שלך באופן מיידי דרך Win32 API מקורי."

msgid "開啟測試模式 (Test Mode)"
msgstr "הפעל מצב בדיקה"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "המערכת תקבל מנהלי התקנים חתומים לבדיקה. סימן מים של \"מצב בדיקה\" יופיע בשולחן העבודה.\n\n• יש לכבות את Secure Boot ב-BIOS תחילה\n• רוב מנגנוני Anti-Cheat (כגון EAC, BattlEye) יחסמו משחקים\n• נדרש אתחול כדי להחיל. בחר \"השבת מצב בדיקה\" לביטול"

msgid "關閉測試模式"
msgstr "השבת מצב בדיקה"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "השבתת מצב בדיקה משחזרת אימות חתימת מנהלי התקנים רגילה. נדרש אתחול."

msgid "停用驅動程式強制簽章"
msgstr "השבת אכיפת חתימת מנהל התקן"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "מבטל לחלוטין את אימות חתימת מנהלי ההתקנים ב-Windows‏ (nointegritychecks).\n\n• מאפשר התקנת מנהלי התקנים ללא חתימה\n• אבטחת המערכת תופחת באופן משמעותי\n• יש לבטל את Secure Boot ב-BIOS תחילה\n• נדרש אתחול כדי להחיל."

msgid "恢復強制簽章驗證"
msgstr "שחזר אכיפת חתימת מנהל התקן"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "ישחזר את מנגנון אימות חתימות מנהלי ההתקנים המוגדר כברירת מחדל ב-Windows. נדרש אתחול."

msgid "恢復系統安全防護"
msgstr "שחזר את אבטחת המערכת"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "ישחזר את ברירת המחדל של אימות החתימות ואבטחת הליבה של Windows.\n\nנדרש אתחול כדי להחיל במלואו. האם להמשיך?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "אזהרה: פעולה זו תשבית את אכיפת חתימת מנהלי ההתקנים ותכבה את שלמות הזיכרון, מה שיפחית משמעותית את האבטחה.\n\nנדרש אתחול כדי להחיל. האם להמשיך?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "אזהרה: הפעלת מצב בדיקה תאפשר טעינת מנהלי התקנים לא חתומים ותפחית את האבטחה באופן משמעותי.\n\nנדרש אתחול כדי להחיל. האם להמשיך?"

msgid "解除驅動與核心安全限制"
msgstr "השבת מגבלות אבטחת דרייבר וליבה"

