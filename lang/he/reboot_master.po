msgstr "\n[הפעלה] משחזר אכיפת חתימות (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已恢復正常，請重新開機以生效。\n"
msgstr "[הצלחה] אכיפת חתימת מנהלי ההתקנים שוחזרה. הפעל מחדש כדי להחיל.\n"

msgid "\n[執行] 正在恢復系統安全防護...\n"
msgstr "\n[הפעלה] משחזר אבטחת מערכת...\n"

msgid "  [錯誤] 關閉 nointegritychecks 失敗: {}\n"
msgstr "  [שגיאה] כיבוי nointegritychecks נכשל: {}\n"

msgid "  - 驅動強制簽章已恢復\n"
msgstr "  - אכיפת חתימת מנהלי התקנים שוחזרה\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [שגיאה] כיבוי testsigning נכשל: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [שגיאה] כתיבה לרישום נכשלה (קוד {}): לא ניתן להפעיל שלמות זיכרון\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - שלמות זיכרון הופעלה\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - מצב בדיקה הושבת\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - אבטחת המערכת שוחזרה\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [שגיאה] כתיבה לרישום נכשלה (קוד שגיאה {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[אזהרה] אירעו שגיאות. אנא בדוק את היומן למעלה.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[הצלחה] האבטחה שוחזרה. הפעל מחדש כדי להחיל.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[הפעלה] מסיר מגבלות אבטחת דרייבר וליבה...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [שגיאה] הפעלת nointegritychecks נכשלה: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - אכיפת חתימת מנהלי התקנים הושבתה\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [שגיאה] כתיבה לרישום נכשלה (קוד {}): לא ניתן לכבות שלמות זיכרון\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - שלמות זיכרון כבויה\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [שגיאה] הפעלת testsigning נכשלה: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - מצב בדיקה הופעל\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - רשימת חסימת מנהלי התקנים כבויה\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[הצלחה] מגבלות האבטחה בוטלו. הפעל מחדש כדי להחיל.\n"

