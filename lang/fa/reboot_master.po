msgid "  - 測試模式已關閉\n"
msgstr "  - حالت آزمایشی غیرفعال شد\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - امنیت سیستم بازیابی شد\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [خطا] نوشتن در رجیستری ناموفق بود (کد خطا: {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[هشدار] خطاهایی رخ داد. لطفاً گزارش بالا را بررسی کنید.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[موفق] امنیت بازیابی شد. برای اعمال راه‌اندازی مجدد کنید.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[اجرا] لغو محدودیت‌های امنیتی درایور و هسته...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
