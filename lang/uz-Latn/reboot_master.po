msgid "成功建立 PE 啟動項，但發送重啟訊號失敗，請手動重新啟動電腦。"
msgstr "PE yuklash yozuvi yaratildi, ammo qayta ishga tushirish signali uzatilmadi. Qoʻlda qayta ishga tushiring."

msgid "恢復驅動與核心安全防護"
msgstr "Drayver va yadro xavfsizligini tiklash"

msgid "解除驅動與核心安全限制"
msgstr "Drayver va yadro xavfsizlik cheklovlarini olib tashlash"

msgid "包含測試模式、強制簽章與記憶體完整性。\n勾選下方項目並點擊按鈕，設定將於下次重開機後生效。"
msgstr "Test rejimi, imzoni majburlash va xotira yaxlitligini oʻz ichiga oladi.\nTanlang va qoʻllang. Sozlamalar keyingi yuklanishda kuchga kiradi."

msgid "停用驅動封鎖規則"
msgstr "Drayver bloklash roʻyxatini oʻchirish"

msgid "關閉記憶體完整性"
msgstr "Xotira yaxlitligini oʻchirish"

msgid "恢復預設安全"
msgstr "Standart xavfsizlikni tiklash"

msgid "套用變更"
msgstr "Oʻzgarishlarni qoʻllash"

msgid "重啟大師 (Reboot Master)"
msgstr "Reboot Master"

msgid "系統就緒。請選擇操作項目。"
msgstr "Tizim tayyor. Amalni tanlang."

msgid "USB啟動"
msgstr "USB orqali yuklash"

msgid "掃描 USB 裝置中..."
msgstr "USB qurilmalari skanlanmoqda..."

msgid "確定要執行此操作？"
