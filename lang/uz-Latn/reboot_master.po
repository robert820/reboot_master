msgstr "  [Xato] nointegritychecks yoqilmadi: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Drayver imzosini majburlash oʻchirildi\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Xato] Reestrga yozish amalga oshmadi (kod {}): Xotira yaxlitligini oʻchirib boʻlmadi\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Xotira yaxlitligi oʻchirildi\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Xato] testsigning yoqilmadi: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Test rejimi yoqildi\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Drayver bloklash roʻyxati oʻchirildi\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[Muvaffaqiyatli] Xavfsizlik cheklovlari olib tashlandi. Qayta ishga tushiring.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "USB disk ulandi: {} {}"

msgid "移除了隨身碟/磁碟: {} {}"
msgstr "USB disk uzildi: {} {}"

msgid "未偵測到包含 PE 環境的隨身碟"
msgstr "PE muhitiga ega boʻlgan USB disk aniqlanmadi"

msgid "未插入任何隨身碟"
msgstr "Birorta ham USB disk ulanmagan"

