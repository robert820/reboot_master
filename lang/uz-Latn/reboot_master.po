msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Amal: {}\n  Tafsilotlar: {}\n  Holati: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Hozircha faoliyat tarixi yoʻq.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "SeShutdownPrivilege tizim imtiyozini olib boʻlmadi"

msgid "關機失敗，錯誤碼: {}"
msgstr "Oʻchirish amalga oshmadi, xato kodi: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "SeShutdownPrivilege qayta ishga tushirish imtiyozini olib boʻlmadi"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Qayta ishga tushirish amalga oshmadi, xato kodi: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "SeSystemEnvironmentPrivilege imtiyozi olinmadi. Administrator sifatida ishga tushiring"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Ona plata yoki OT toʻgʻridan-toʻgʻri BIOS/UEFI sozlamalariga qayta yuklashni qoʻllab-quvvatlamaydi"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "UEFI oʻzgaruvchisini yozish amalga oshmadi. Antivirus yoki ruxsatlar tomonidan bloklangan."

msgid "重啟至 BIOS/UEFI"
msgstr "BIOS/UEFI-ga qayta ishga tushirish"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "UEFI oʻzgaruvchisi yozildi: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 1 ga oʻrnatildi (BootToFwUI)"

msgid "準備重啟"
msgstr "Qayta ishga tushirishga tayyorlanmoqda"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "UEFI oʻzgaruvchisi muvaffaqiyatli yozildi. BIOS/UEFI-ga qayta ishga tushirilmoqda..."

msgid "執行 bcdedit 失敗: {}"
msgstr "bcdedit bajarilmadi: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` bajarilmadi: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Jismoniy tizimning SOFTWARE reestr uyasi topilmadi"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "bcdedit chiqishida yangi GUID boshlanishi topilmadi"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "bcdedit chiqishida yangi GUID oxiri topilmadi"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Joriy bajariluvchi fayl yoʻlini olib boʻlmadi: {}"

msgid "一次性安全模式"
msgstr "Bir martalik xavfsiz rejim"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Rejim: {}\n  Vaqtinchalik GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Bir martalik xavfsiz rejim sozlandi. Qayta ishga tushirilmoqda..."

msgid "重啟至進階開機選單"
msgstr "Kengaytirilgan yuklash menyusiga qayta ishga tushirish"

msgid "建立臨時副本 GUID: {}"
msgstr "Vaqtinchalik yozuv GUID yaratildi: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Bir martalik kengaytirilgan yuklash parametrlari sozlandi. Qayta ishga tushirish talab qilinadi..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "BIOS / UEFI dasturiy taʼminotiga qayta ishga tushirish"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Kompyuterni darhol qayta ishga tushiradi va BIOS/UEFI sozlamalariga avtomatik kiradi."

msgid "一次性安全模式 (Minimal)"
msgstr "Bir martalik xavfsiz rejim (minimal)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Bir marta xavfsiz rejimda yuklanadi. Keyingi qayta ishga tushirishda odatiy rejimga qaytadi."

msgid "一次性安全模式 (含網路)"
msgstr "Bir martalik xavfsiz rejim (tarmoq bilan)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Bir marta tarmoqli xavfsiz rejimda yuklanadi. Keyingi qayta ishga tushirishda odatiy rejimga qaytadi."

msgid "重啟進入進階開機選單"
msgstr "Kengaytirilgan ishga tushirish parametrlariga qayta ishga tushirish"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Kompyuterni qayta ishga tushiradi va Windows kengaytirilgan ishga tushirish menyusini ochadi."

msgid "直接強制重啟電腦"
msgstr "Majburiy qayta ishga tushirish"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Mahalliy Win32 API orqali kompyuteringizni darhol qayta ishga tushiradi."

msgid "直接安全關機"
msgstr "Xavfsiz oʻchirish"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Mahalliy Win32 API orqali kompyuteringizni darhol oʻchiradi."

msgid "開啟測試模式 (Test Mode)"
msgstr "Test rejimini yoqish"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Tizim test imzoli drayverlarni qabul qiladi. Ish stolida \"Test rejimi\" belgisi paydo boʻladi.\n\n• Avval BIOS’da Secure Boot oʻchirilishi kerak\n• Koʻpchilik anti-cheat tizimlari (EAC, BattlEye) oʻyinlarni bloklaydi\n• Kuchga kirishi uchun qayta ishga tushirish talab qilinadi"

msgid "關閉測試模式"
msgstr "Test rejimini oʻchirish"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Test rejimini oʻchirish standart drayver imzosini tekshirishni tiklaydi. Qayta ishga tushirish talab qilinadi."

msgid "停用驅動程式強制簽章"
msgstr "Drayver imzosini majburlashni oʻchirish"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Windows drayver raqamli imzosini tekshirishni butunlay oʻchiradi (nointegritychecks).\n\n• Imzolanmagan drayverlarni oʻrnatishga ruxsat beradi\n• Tizim xavfsizligi sezilarli darajada pasayadi\n• Avval BIOS’da Secure Boot oʻchirilishi kerak\n• Qayta ishga tushirish talab qilinadi."

msgid "恢復強制簽章驗證"
msgstr "Imzoni majburlashni tiklash"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Windows standart drayver raqamli imzosini tekshirish mexanizmini tiklaydi. Qayta ishga tushirish talab qilinadi."

msgid "恢復系統安全防護"
msgstr "Tizim xavfsizligini tiklash"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Windows standart imzo tekshiruvi va yadro xavfsizligini tiklaydi.\n\nToʻliq kuchga kirishi uchun qayta ishga tushirish kerak. Davom ettirilsinmi?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ogohlantirish: Drayver imzosini majburlash va xotira yaxlitligini oʻchirib, xavfsizlikni sezilarli darajada pasaytiradi.\n\nQayta ishga tushirish talab qilinadi. Davom ettirilsinmi?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ogohlantirish: Imzolanmagan drayverlarni yuklash uchun test rejimini yoqadi, bu xavfsizlikni sezilarli darajada pasaytiradi.\n\nQayta ishga tushirish kerak. Davom ettirilsinmi?"

msgid "解除驅動與核心安全限制"
msgstr "Drayver va yadro xavfsizlik cheklovlarini olib tashlash"

