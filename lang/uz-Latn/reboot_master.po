msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Xato] Reestrga yozish amalga oshmadi (xato kodi: {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Ogohlantirish] Xatoliklar yuz berdi. Yuqoridagi jurnalni tekshiring.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[Muvaffaqiyatli] Xavfsizlik tiklandi. Kuchga kirishi uchun qayta ishga tushiring.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Ijro] Drayver va yadro xavfsizlik cheklovlari olib tashlanmoqda...\n"

