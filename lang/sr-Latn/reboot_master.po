msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Radnja: {}\n  Detalji: {}\n  Status: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Još nema istorije aktivnosti.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Nije moguće dobiti sistemsku privilegiju SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Isključivanje nije uspelo, kôd greške: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Nije moguće dobiti privilegiju ponovnog pokretanja SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Ponovno pokretanje nije uspelo, kôd greške: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Nije moguće dobiti SeSystemEnvironmentPrivilege. Pokrenite kao administrator"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Matična ploča ili OS ne podržava direktno ponovno pokretanje u BIOS/firmver"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Upisivanje UEFI promenljive nije uspelo. Blokirano antivirusom ili dozvolama."

msgid "重啟至 BIOS/UEFI"
msgstr "Ponovo pokreni u BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Upisana UEFI promenljiva: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 postavljen na 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Priprema za ponovno pokretanje"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "UEFI promenljiva je uspešno upisana. Ponovno pokretanje u BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Pokretanje bcdedit nije uspelo: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` nije uspeo: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Nije pronađena SOFTWARE košnica registra fizičkog sistema"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Nije pronađen početak novog GUID-a u bcdedit izlazu"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Nije pronađen kraj novog GUID-a u bcdedit izlazu"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Nije moguće dobiti putanju trenutne izvršne datoteke: {}"

msgid "一次性安全模式"
msgstr "Jednokratni bezbedni režim"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Režim: {}\n  Privremeni GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Jednokratni bezbedni režim je podešen. Ponovno pokretanje..."

msgid "重啟至進階開機選單"
msgstr "Ponovo pokreni u napredni meni pokretanja"

msgid "建立臨時副本 GUID: {}"
msgstr "Kreiran privremeni GUID unosa: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Jednokratne napredne opcije pokretanja su podešene. Ponovno pokretanje..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Ponovo pokreni u BIOS / UEFI firmver"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Odmah ponovo pokreće računar i automatski ulazi u BIOS/UEFI podešavanja."

msgid "一次性安全模式 (Minimal)"
msgstr "Jednokratni bezbedni režim (minimalni)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Pokreće se u bezbednom režimu jednom. Vraća se u normalni režim pri sledećem pokretanju."

msgid "一次性安全模式 (含網路)"
msgstr "Jednokratni bezbedni režim (sa mrežom)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Pokreće se u bezbednom režimu sa mrežom jednom. Vraća se u normalu pri sledećem pokretanju."

msgid "重啟進入進階開機選單"
msgstr "Ponovo pokreni u napredne opcije pokretanja"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Ponovo pokreće računar i otvara Windows meni za napredno pokretanje i rešavanje problema."

msgid "直接強制重啟電腦"
msgstr "Prinudno ponovo pokreni"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Odmah ponovo pokreće računar koristeći izvorni Win32 API."

msgid "直接安全關機"
msgstr "Bezbedno isključi odmah"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Odmah isključuje računar koristeći izvorni Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Omogući režim testiranja"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Sistem će prihvatiti drajvere sa testnim potpisom. Pojaviće se vodeni žig „Režim testiranja”.\n\n• Secure Boot mora prvo biti isključen u BIOS-u\n• Većina anti-cheat sistema (EAC, BattlEye) blokiraće igre\n• Potrebno je ponovno pokretanje. Izaberite „Onemogući režim testiranja” za isključivanje"

msgid "關閉測試模式"
msgstr "Onemogući režim testiranja"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Onemogućavanje režima testiranja vraća standardnu proveru potpisa drajvera. Potrebno je ponovno pokretanje."

msgid "停用驅動程式強制簽章"
msgstr "Onemogući prinudno potpisivanje drajvera"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Potpuno isključuje proveru potpisa drajvera u Windows-u (nointegritychecks).\n\n• Omogućava instalaciju nepotpisanih drajvera\n• Bezbednost sistema će biti značajno umanjena\n• Secure Boot mora prvo biti isključen u BIOS-u\n• Potrebno je ponovno pokretanje."

msgid "恢復強制簽章驗證"
msgstr "Vrati prinudno potpisivanje"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Vraća podrazumevanu Windows verifikaciju potpisa drajvera. Potrebno je ponovno pokretanje."

msgid "恢復系統安全防護"
msgstr "Vrati bezbednost sistema"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Vratiće podrazumevanu verifikaciju potpisa i bezbednost kernela.\n\nPotrebno je ponovno pokretanje. Želite li da nastavite?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Upozorenje: Onemogućava prinudno potpisivanje drajvera i isključuje integritet memorije, znatno smanjujući bezbednost.\n\nPotrebno je ponovno pokretanje. Nastaviti?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Upozorenje: Omogućava režim testiranja za učitavanje nepotpisanih drajvera, znatno smanjujući bezbednost.\n\nPotrebno je ponovno pokretanje. Nastaviti?"

msgid "解除驅動與核心安全限制"
msgstr "Ukini ograničenja drajvera i kernela"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Pokreni] Zahteva se ponovno pokretanje u BIOS/UEFI...\n"

