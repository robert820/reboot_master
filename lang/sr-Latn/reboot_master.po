msgstr "\n[Pokreni] Onemogućavanje režima testiranja...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[Uspešno] Režim testiranja je onemogućen. Ponovo pokrenite za primenu.\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[Pokreni] Onemogućavanje prinudnog potpisivanja (nointegritychecks)...\n"

