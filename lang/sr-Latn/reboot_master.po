msgid "恢復預設安全"
msgstr "Vrati podrazumevanu bezbednost"

msgid "套用變更"
msgstr "Primeni izmene"

msgid "重啟大師 (Reboot Master)"
msgstr "Reboot Master"

msgid "系統就緒。請選擇操作項目。"
msgstr "Sistem je spreman. Izaberite radnju."

msgid "USB啟動"
msgstr "Pokretanje sa USB-a"

msgid "掃描 USB 裝置中..."
msgstr "Skeniranje USB uređaja..."

msgid "確定要執行此操作？"
msgstr "Da li ste sigurni da želite da nastavite?"

msgid "即將執行選定的重啟或關機操作。"
msgstr "Izabrana radnja ponovnog pokretanja ili isključivanja će se izvršiti."

msgid "重啟管理"
msgstr "Upravljanje restartom"

msgid "說明"
msgstr "Pomoć"

msgid "聲明"
msgstr "Odricanje odgovornosti"

msgid "外觀：跟隨系統 (點擊切換反色)"
