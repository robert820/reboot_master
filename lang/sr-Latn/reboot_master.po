msgstr "  [Greška] Upis u registar nije uspeo (kôd greške {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Upozorenje] Došlo je do grešaka. Proverite dnevnik iznad.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[Uspešno] Bezbednost je vraćena. Ponovo pokrenite za primenu.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Pokreni] Ukidanje bezbednosnih ograničenja drajvera i kernela...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Greška] Uključivanje nointegritychecks nije uspelo: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Prinudno potpisivanje drajvera je onemogućeno\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Greška] Upis u registar nije uspeo (kôd {}): Nije moguće isključiti integritet memorije\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Integritet memorije je isključen\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Greška] Uključivanje testsigning nije uspelo: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Režim testiranja je uključen\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Lista blokiranih drajvera je isključena\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[Uspešno] Bezbednosna ograničenja su ukinuta. Ponovo pokrenite za primenu.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "USB disk je dodat: {} {}"

