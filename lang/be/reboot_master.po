msgstr "[{}] Дзеянне: {}\n  Падрабязнасці: {}\n  Статус: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Гісторыі дзеянняў пакуль няма.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Немагчыма атрымаць сістэмны прывілей SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Памылка выключэння, код памылкі: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Немагчыма атрымаць прывілей перазагрузкі SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Памылка перазагрузкі, код памылкі: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Немагчыма атрымаць SeSystemEnvironmentPrivilege. Запусціце ад імя адміністратара"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Мацярынская плата або АС не падтрымлівае перазагрузку ў налады BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Не ўдалося запісаць зменную UEFI. Заблакавана антывірусам або дазволамі."

msgid "重啟至 BIOS/UEFI"
msgstr "Перазагрузіць у BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Запісана зменная UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Біт 0 усталяваны ў 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Падрыхтоўка да перазагрузкі"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Пераменная UEFI паспяхова запісана. Перазагрузка ў BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Не ўдалося выканаць bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` не ўдалося: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Не знойдзены куст рэестра SOFTWARE фізічнай сістэмы"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Не ўдалося знайсці пачатак новага GUID у вывадзе bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Не ўдалося знайсці канец новага GUID у вывадзе bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Немагчыма атрымаць шлях да бягучага выканальнага файла: {}"

msgid "一次性安全模式"
msgstr "Аднаразовы бяспечны рэжым"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Рэжым: {}\n  Часовы GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Аднаразовы бяспечны рэжым наладжаны. Перазагрузка..."

msgid "重啟至進階開機選單"
msgstr "Перазагрузіць у дадатковае меню запуску"

msgid "建立臨時副本 GUID: {}"
msgstr "Створаны часовы GUID запісу: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Аднаразовыя дадатковыя параметры запуску наладжаны. Перазагрузка..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Перазагрузіць у прашыўку BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Неадкладна перазагружае камп’ютар і аўтаматычна адкрывае налады BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Аднаразовы бяспечны рэжым (мінімальны)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Аднаразовая загрузка ў бяспечным рэжыме. Пры наступным перазапуску вернецца звычайны рэжым."

msgid "一次性安全模式 (含網路)"
msgstr "Аднаразовы бяспечны рэжым (з сеткай)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Аднаразовая загрузка ў бяспечным рэжыме з сеткай. Пры наступным перазапуску вернецца звычайны рэжым."

msgid "重啟進入進階開機選單"
msgstr "Перазагрузіць у дадатковыя параметры запуску"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Перазагружае камп’ютар і адкрывае меню дадатковага запуску і ліквідацыі непаладак Windows."

msgid "直接強制重啟電腦"
msgstr "Прымусова перазагрузіць зараз"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Неадкладна перазагружае камп’ютар праз натыўны Win32 API."

msgid "直接安全關機"
msgstr "Бяспечнае выключэнне зараз"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Неадкладна выключае камп’ютар праз натыўны Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Уключыць тэставы рэжым"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Сістэма будзе прымаць драйверы з тэставым подпісам. На працоўным стале з’явіцца вадзяны знак «Тэставы рэжым».\n\n• Спачатку трэба адключыць Secure Boot у BIOS\n• Большасць антычытаў (EAC, BattlEye) заблакуюць гульні ў гэтым рэжыме\n• Патрабуецца перазагрузка. Выкарыстоўвайце «Адключыць тэставы рэжым»"

msgid "關閉測試模式"
msgstr "Адключыць тэставы рэжым"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Адключэнне тэставага рэжыму аднаўляе стандартную праверку подпісу драйвераў. Патрабуецца перазагрузка."

msgid "停用驅動程式強制簽章"
msgstr "Адключыць абавязковую праверку подпісу драйвераў"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Цалкам адключае праверку лічбавых подпісаў драйвераў Windows (nointegritychecks).\n\n• Дазваляе ўсталёўку непадпісаных драйвераў\n• Бяспека сістэмы значна знізіцца\n• Спачатку трэба адключыць Secure Boot у BIOS\n• Патрабуецца перазагрузка."

msgid "恢復強制簽章驗證"
msgstr "Аднавіць абавязковую праверку подпісу"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Аднаўляе стандартную праверку лічбавых подпісаў драйвераў Windows. Патрабуецца перазагрузка."

msgid "恢復系統安全防護"
msgstr "Аднавіць бяспеку сістэмы"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ановіць стандартную праверку подпісаў і бяспеку ядра Windows.\n\nДля поўнага прымянення патрабуецца перазагрузка. Працягнуць?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Папярэджанне: Адключае праверку подпісаў драйвераў і цэласнасць памяці, што значна зніжае бяспеку.\n\nПатрабуецца перазагрузка. Працягнуць?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Папярэджанне: Уключае тэставы рэжым для загрузкі непадпісаных драйвераў, што зніжае бяспеку.\n\nПатрабуецца перазагрузка. Працягнуць?"

msgid "解除驅動與核心安全限制"
msgstr "Зняць абмежаванні бяспекі драйвераў і ядра"

