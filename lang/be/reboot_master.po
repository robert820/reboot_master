msgstr "  - Абавязковая праверка подпісу драйвераў адноўлена\n"

msgid "  [錯誤] 關閉 testsigning 失敗: {}\n"
msgstr "  [Памылка] Не ўдалося адключыць testsigning: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [Памылка] Збой запісу ў рэестр (код {}): не ўдалося ўключыць цэласнасць памяці\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - Цэласнасць памяці ўключана\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - Тэставы рэжым адключаны\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - Бяспека сістэмы адноўлена\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Памылка] Збой запісу ў рэестр (код памылкі {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Папярэджанне] Узніклі памылкі. Праверце журнал вышэй.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[Паспяхова] Бяспека адноўлена. Перазагрузіце для прымянення.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Выкананне] Зняцце абмежаванняў бяспекі драйвераў і ядра...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Памылка] Не ўдалося ўключыць nointegritychecks: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Абавязковая праверка подпісу драйвераў адключана\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Памылка] Збой запісу ў рэестр (код {}): не ўдалося адключыць цэласнасць памяці\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Цэласнасць памяці адключана\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Памылка] Не ўдалося ўключыць testsigning: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Тэставы рэжым уключаны\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Спіс блакіроўкі драйвераў адключаны\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[Паспяхова] Абмежаванні бяспекі зняты. Перазагрузіце для прымянення.\n"

