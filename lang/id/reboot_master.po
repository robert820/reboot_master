msgstr "\n[Jalankan] Menonaktifkan Mode Uji...\n"

msgid "[成功] 測試模式已關閉，請重新開機以生效。\n"
msgstr "[Sukses] Mode Uji dinonaktifkan. Mulai ulang agar berlaku.\n"

msgid "\n[執行] 正在停用強制簽章 (nointegritychecks)...\n"
msgstr "\n[Jalankan] Menonaktifkan penegakan tanda tangan (nointegritychecks)...\n"

msgid "[成功] 強制簽章驗證已停用，請重新開機以生效。\n"
msgstr "[Sukses] Penegakan tanda tangan dinonaktifkan. Mulai ulang agar berlaku.\n"

msgid "[錯誤] {}\n提示：請確認是否具備系統管理員權限，或先到 BIOS 關閉 Secure Boot。\n"
msgstr "[Kesalahan] {}\nPetunjuk: Periksa hak administrator atau nonaktifkan Secure Boot di BIOS.\n"

