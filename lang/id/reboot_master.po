msgid "呼叫原生 API 強制重新啟動電腦"
msgstr "Paksa mulai ulang komputer melalui API asli."

msgid "進階開機選單"
msgstr "Menu Startup Lanjutan"

msgid "進入 Windows 修復環境 (WinRE) 與啟動設定"
msgstr "Masuk ke Lingkungan Pemulihan Windows (WinRE) & pengaturan startup."

msgid "自動偵測USB裝置並使用USB裝置啟動"
msgstr "Deteksi otomatis dan boot dari perangkat USB."

msgid "安全模式 (含網路)"
msgstr "Safe Mode (dengan Jaringan)"

msgid "支援連線之排錯模式，第二次重啟自動復原"
msgstr "Pemecahan masalah dengan jaringan. Kembali normal pada boot kedua."

msgid "安全關機"
msgstr "Matikan Aman"

msgid "呼叫原生 API 安全關閉電腦電源"
msgstr "Matikan komputer secara aman melalui API asli."

msgid "恢復系統安全防護"
msgstr "Pulihkan Keamanan Sistem"

msgid "停用驅動強制簽章"
msgstr "Nonaktifkan Penegakan Tanda Tangan"

msgid "啟用驅動測試模式"
msgstr "Aktifkan Mode Uji Driver"

msgid "32 位元系統無強制核心簽章限制，無需解鎖。"
msgstr "Sistem 32-bit tidak memberlakukan tanda tangan kernel. Tidak perlu dibuka kunci."

msgid "恢復預設數位簽章驗證與防護。點擊卡片套用並重啟。"
msgstr "Pulihkan verifikasi tanda tangan digital default. Klik untuk menerapkan dan mulai ulang."

msgid "關閉數位簽章驗證與記憶體完整性。點擊卡片套用。"
msgstr "Nonaktifkan verifikasi tanda tangan digital dan Integritas Memori. Klik untuk terapkan."

msgid "允許載入無簽章驅動。點擊右側展開選項。"
msgstr "Izinkan memuat driver tanpa tanda tangan. Klik kanan untuk buka opsi."

msgid "去除測試模式浮水印"
msgstr "Hapus Tanda Air Mode Uji"

msgid "操作日誌歷史"
msgstr "Riwayat Log Aktivitas"

msgid "檢視所有執行過的指令與系統回報紀錄。"
msgstr "Lihat semua perintah yang dijalankan dan respons sistem."

msgid "複製日誌"
msgstr "Salin Log"

msgid "回上一頁"
msgstr "Kembali"

msgid "操作說明"
msgstr "Panduan Penggunaan"

msgid "了解重啟大師的操作細節與底層架構設計。"
msgstr "Pelajari cara kerja Reboot Master dan arsitektur dasarnya."

msgid "軟體功能與優先級設計"
msgstr "Fitur & Prioritas Eksekusi"

msgid "本軟體依循「原生 Win32 API 優先 > DLL 導出函式 > 系統管理指令」之架構設計。直接關機與重啟採用 ExitWindowsEx API；安全模式則透過 BCD 一次性導引機制（/bootsequence），確保重啟一次進入安全模式後，下次重開機即自動回歸標準正常模式。"
msgstr "Dirancang berdasarkan \"Win32 API Asli > Ekspor DLL > Perintah Sistem\". Penonaktifan dan mulai ulang menggunakan ExitWindowsEx; Safe Mode memanfaatkan mekanisme boot satu kali BCD (/bootsequence), yang otomatis kembali ke mode normal pada mulai ulang berikutnya."

msgid "得翼科技 (DEI 3C)"
msgstr "DEI Tech (DEI 3C)"

msgid "效能無界限，讓您的數位生活隨心所欲"
msgstr "Performa tanpa batas, memberdayakan kehidupan digital Anda."

msgid "電腦組裝"
msgstr "Perakitan PC"

msgid "筆電升級"
msgstr "Peningkatan Laptop"

msgid "網路規劃"
msgstr "Perencanaan Jaringan"

msgid "資安防護"
msgstr "Keamanan Siber"

msgid "官方頻道與社群"
msgstr "Saluran Resmi & Komunitas"

msgid "前往官方部落格"
msgstr "Kunjungi Blog Resmi"

msgid "重啟大師 (Reboot Master) "
msgstr "Reboot Master "

msgid "使用者條款與免責聲明"
msgstr "Ketentuan Penggunaan & Penafian"

msgid "請在使用本軟體前詳細閱讀以下條款與資料安全提醒。"
msgstr "Harap baca ketentuan berikut dan pemberitahuan keamanan data dengan cermat sebelum menggunakan."

msgid "資料安全提醒與免責聲明"
msgstr "Pemberitahuan Keamanan Data & Penafian"

msgid "歡迎使用「重啟大師 (Reboot Master)」\n\n1. 觸發重新開機或關機前，系統將立即終止所有未儲存之應用程式執行。請使用者於執行前確保所有工作檔案皆已儲存完畢。\n\n2. 本軟體依「現況」免費提供，開發團隊不承擔因硬體相容性（如主機板不支援 UEFI 韌體重啟）或資料未儲存造成之任何直接或間接損失。"
msgstr "Selamat datang di \"Reboot Master\"\n\n1. Memulai ulang atau mematikan akan segera menutup aplikasi yang belum disimpan. Pastikan semua file telah disimpan terlebih dahulu.\n\n2. Perangkat lunak ini disediakan gratis \"apa adanya\". Tim tidak bertanggung jawab atas ketidakcocokan perangkat keras atau kehilangan data."

msgid "調整語言、外觀與軟體更新。"
msgstr "Sesuaikan bahasa, tampilan, dan pembaruan."

msgid "語言"
msgstr "Bahasa"

msgid "選擇介面顯示語言。"
msgstr "Pilih bahasa tampilan antarmuka."

msgid "繁體中文"
msgstr "Tionghoa Tradisional"

msgid "简体中文"
msgstr "Tionghoa Sederhana"

msgid "外觀"
msgstr "Tampilan"

msgid "選擇淺色、深色，或跟隨系統設定。"
msgstr "Pilih Terang, Gelap, atau ikuti pengaturan sistem."

msgid "淺色"
msgstr "Terang"

msgid "淺色 (跟隨系統)"
msgstr "Terang (Sistem)"

msgid "深色 (跟隨系統)"
msgstr "Gelap (Sistem)"

msgid "深色"
msgstr "Gelap"

msgid "軟體更新"
msgstr "Pembaruan Perangkat Lunak"

msgid "啟動時會自動檢查 GitHub 上的最新版本。"
msgstr "Memeriksa versi terbaru di GitHub secara otomatis saat startup."

msgid "目前版本："
msgstr "Versi saat ini: "

msgid "正在檢查更新..."
msgstr "Memeriksa pembaruan..."

msgid "發現新版本："
msgstr "Versi baru tersedia: "

msgid "目前已是最新版本。"
msgstr "Anda sudah menggunakan versi terbaru."

msgid "無法連線至 GitHub，請檢查網路連線。"
msgstr "Tidak dapat terhubung ke GitHub. Periksa koneksi jaringan Anda."

msgid "正在下載更新，完成後將自動重新啟動..."
msgstr "Mengunduh pembaruan. Aplikasi akan dimulai ulang otomatis setelah selesai..."

msgid "尚未檢查更新。"
msgstr "Belum memeriksa pembaruan."

msgid "檢查更新"
msgstr "Periksa Pembaruan"

msgid "立即更新"
msgstr "Perbarui Sekarang"

msgid "再次確認您的操作"
msgstr "Konfirmasi Tindakan"

msgid "\n\n請確認您的所有工作與文件皆已儲存。確定要立即執行嗎？"
msgstr "\n\nPastikan semua pekerjaan dan dokumen telah disimpan. Yakin ingin menjalankan sekarang?"

msgid "取消"
msgstr "Batal"

msgid "確定執行"
msgstr "Konfirmasi"

msgid "所有安全模式均採用無痕自動清除技術，重啟後將自動還原。"
msgstr "Semua Safe Mode menggunakan pembersihan otomatis tanpa jejak dan pulih saat reboot."

msgid "恢復預設數位簽章驗證與防護。"
msgstr "Pulihkan verifikasi tanda tangan digital dan perlindungan default."

msgid "關閉數位簽章驗證與記憶體完整性"
msgstr "Nonaktifkan verifikasi tanda tangan digital dan Integritas Memori"

msgid "允許載入無簽章之驅動程式。"
msgstr "Izinkan memuat driver yang tidak ditandatangani."

msgid "選擇語言"
msgstr "Pilih Bahasa"

msgid "此功能僅支援 Windows 8 及以上版本。您的系統過舊，請在開機時手動按鍵進入 BIOS。"
msgstr "Fitur ini memerlukan Windows 8 atau lebih baru. Silakan tekan tombol saat boot untuk masuk ke BIOS."

msgid "此系統為傳統 BIOS (Legacy)，無法透過軟體重啟進入 BIOS 設定。請在開機時手動按鍵進入。"
msgstr "Sistem menggunakan Legacy BIOS, tidak dapat reboot via perangkat lunak. Tekan tombol saat boot."

msgid "  [範本解析] 處於 WinPE 環境，採用實體系統預設項 {default}\n"
msgstr "[Templat] Di lingkungan WinPE, menggunakan entri default OS fisik {default} \n"

msgid "  [範本解析] 正在探測當前引導項 {current}...\n"
msgstr "[Templat] Memeriksa entri boot saat ini {saat ini}... \n"

msgid "  [範本解析] 當前會話引導項 {current} 有效，採用為母體範本\n"
msgstr "[Templat] Entri boot saat ini {saat ini} valid, menggunakan templat dasar \n"

msgid "  [範本解析] 偵測到 {current} 已於前次重啟後被清理刪除 (無效識別元)\n"
msgstr "[Templat] Terdeteksi {saat ini} dibersihkan setelah reboot sebelumnya (pengidentifikasi tidak valid) \n"

msgid "  [範本解析] 正在驗證系統永久開機項 {default}...\n"
msgstr "[Templat] Memvalidasi entri boot sistem permanen {default}... \n"

msgid "  [範本解析] 成功選定系統永久開機項 {default} 作為母體範本 (確保一次成功)\n"
msgstr "[Templat] Berhasil memilih entri permanen {default} sebagai templat dasar (memastikan keberhasilan percobaan pertama) \n"

msgid "  [範本解析] 正在掃描 BCD osloader 列表以尋找有效開機項...\n"
msgstr "[Templat] Memindai daftar osloader BCD untuk entri boot yang valid... \n"

msgid "  [範本解析] 從 osloader 列表成功定位實體系統項: {}\n"
msgstr "[Templat] Berhasil menemukan entri OS fisik dari osloader: {} \n"

msgid "  [範本解析] 未能列舉額外開機項，預設採用 {default}\n"
msgstr "[Templat] Tidak dapat menghitung entri tambahan, defaultnya adalah {default} \n"

msgid "  [建立副本] 正在自範本 {} 複製建立臨時安全模式項...\n"
msgstr "[Buat Klon] Menyalin template {} untuk membuat entri Safe Mode sementara... \n"

msgid "  [建立副本] 成功建立副本！\n"
msgstr "[Buat Klon] Klon berhasil dibuat! \n"

msgid "  [降級備援] 複製範本 {} 失敗: {}，啟動備援嘗試 {{default}}...\n"
msgstr "[Fallback] Menyalin template {} gagal: {}, mencoba melakukan fallback dengan {{default}}... \n"

msgid "  [降級備援] 備援方案複製 {default} 成功！\n"
msgstr "[Fallback] Kloning fallback dari {default} berhasil! \n"

msgid "  [降級備援] 備援方案亦失敗: {}\n"
msgstr "[Fallback] Kloning fallback juga gagal: {} \n"

msgid "建立臨時安全模式引導項失敗"
msgstr "Gagal membuat entri boot Mode Aman sementara"

msgid "  [建立副本] 失敗: {}\n"
msgstr "[Buat Klon] Gagal: {} \n"

msgid "  [臨時標識] 取得臨時 GUID: {}\n"
msgstr "[GUID Temp] Memperoleh GUID sementara: {} \n"

msgid "  [選單隱藏] 從開機選單中隱藏此臨時副本 (/displayorder ... /remove)...\n"
msgstr "[Sembunyikan Menu] Menyembunyikan klon sementara dari menu boot (/displayorder ... /remove)... \n"

msgid "  [模式配置] 設定 safeboot 參數為 {}...\n"
msgstr "[Config] Menyetel parameter safeboot ke {}... \n"

msgid "  [一次性引導] 設定單次啟動序列 (/bootsequence)，重啟後 BootMgr 自動復原...\n"
msgstr "[Boot Satu Kali] Mengatur urutan pengambilan tunggal (/bootsequence), BootMgr kembali setelah restart... \n"

msgid "  [開機自毀] 註冊 RunOnce 自毀清理任務 (重啟登入後徹底刪除臨時項目)...\n"
msgstr "[Penghancuran mandiri] Mendaftarkan tugas pembersihan RunOnce (menghapus entri sementara secara permanen setelah login)... \n"

msgid "母體範本: {}\n  模式: {}\n  臨時 GUID: {}"
msgstr "Templat Dasar: {}\nMode: {}\nGUID Temp: {}"

msgid "  [建立副本] 正在自範本 {} 複製建立臨時進階選單項...\n"
msgstr "[Buat Klon] Menyalin template {} untuk membuat entri Opsi Booting Lanjutan sementara... \n"

msgid "建立臨時進階選單引導項失敗"
msgstr "Gagal membuat entri boot Opsi Boot Lanjutan sementara"

msgid "  [進階選項] 啟用 advancedoptions=true (Win7 顯示 F8 選單，Win10/11 顯示開機設定)...\n"
msgstr "[Opsi Lanjutan] Mengaktifkan advancedoptions=true (menu F8 di Win7, Pengaturan Startup di Win10/11)... \n"

msgid "母體範本: {}\n  臨時 GUID: {}"
msgstr "Templat Dasar: {}\nGUID Temp: {}"

