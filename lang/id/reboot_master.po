msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Tindakan: {}\n  Detail: {}\n  Status: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Belum ada riwayat aktivitas.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Tidak dapat memperoleh hak istimewa sistem SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Gagal mematikan, kode kesalahan: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Tidak dapat memperoleh hak istimewa mulai ulang SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Gagal memulai ulang, kode kesalahan: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Tidak dapat memperoleh SeSystemEnvironmentPrivilege. Jalankan sebagai administrator"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Motherboard atau OS tidak mendukung mulai ulang langsung ke pengaturan BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Gagal menulis variabel UEFI. Diblokir oleh antivirus atau perizinan."

msgid "重啟至 BIOS/UEFI"
msgstr "Mulai Ulang ke BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Menulis variabel UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bit 0 diatur ke 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Mempersiapkan mulai ulang"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Variabel UEFI berhasil ditulis. Memulai ulang ke BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Gagal menjalankan bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` gagal: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Tidak dapat menemukan hive registri SOFTWARE pada sistem fisik"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Tidak dapat menemukan awal GUID baru pada output bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Tidak dapat menemukan akhir GUID baru pada output bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Tidak dapat memperoleh jalur berkas yang sedang dieksekusi: {}"

msgid "一次性安全模式"
msgstr "Safe Mode Satu Kali"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Mode: {}\n  GUID Sementara: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Safe Mode satu kali berhasil dikonfigurasi. Memulai ulang..."

msgid "重啟至進階開機選單"
msgstr "Mulai Ulang ke Menu Startup Lanjutan"

msgid "建立臨時副本 GUID: {}"
msgstr "GUID entri sementara dibuat: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Opsi Boot Lanjutan satu kali berhasil diatur. Memulai ulang..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Mulai Ulang ke Firmware BIOS / UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Memulai ulang komputer segera dan otomatis masuk ke pengaturan BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Safe Mode Satu Kali (Minimal)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Boot ke Safe Mode sekali. Otomatis kembali ke mode normal pada mulai ulang berikutnya."

msgid "一次性安全模式 (含網路)"
msgstr "Safe Mode Satu Kali (dengan Jaringan)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Boot ke Safe Mode dengan Jaringan sekali. Otomatis kembali ke mode normal pada mulai ulang berikutnya."

msgid "重啟進入進階開機選單"
msgstr "Mulai Ulang ke Opsi Startup Lanjutan"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Memulai ulang komputer dan membuka menu Startup Lanjutan & Pemecahan Masalah Windows."

msgid "直接強制重啟電腦"
msgstr "Paksa Mulai Ulang Sekarang"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Memulai ulang komputer Anda segera menggunakan Win32 API asli."

msgid "直接安全關機"
msgstr "Matikan Aman Sekarang"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Mematikan daya komputer Anda segera menggunakan Win32 API asli."

msgid "開啟測試模式 (Test Mode)"
msgstr "Aktifkan Mode Uji"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Sistem akan menerima driver yang ditandatangani uji. Tanda air \"Test Mode\" akan muncul di desktop.\n\n• Secure Boot harus dinonaktifkan di BIOS terlebih dahulu\n• Sebagian besar anti-cheat (EAC, BattlEye) akan memblokir game dalam mode ini\n• Perlu mulai ulang agar berlaku. Gunakan \"Nonaktifkan Mode Uji\" untuk mematikan"

msgid "關閉測試模式"
msgstr "Nonaktifkan Mode Uji"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Menonaktifkan Mode Uji memulihkan verifikasi tanda tangan driver standar. Mulai ulang diperlukan."

msgid "停用驅動程式強制簽章"
msgstr "Nonaktifkan Penegakan Tanda Tangan Driver"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Mematikan total verifikasi tanda tangan driver Windows (nointegritychecks).\n\n• Mengizinkan pemasangan driver yang tidak ditandatangani\n• Keamanan sistem akan sangat menurun\n• Secure Boot harus dinonaktifkan di BIOS terlebih dahulu\n• Perlu mulai ulang agar berlaku."

msgid "恢復強制簽章驗證"
msgstr "Pulihkan Penegakan Tanda Tangan"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Memulihkan mekanisme verifikasi tanda tangan driver bawaan Windows. Mulai ulang diperlukan."

msgid "恢復系統安全防護"
msgstr "Pulihkan Keamanan Sistem"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Memulihkan verifikasi tanda tangan dan keamanan kernel bawaan Windows.\n\nPerlu mulai ulang agar diterapkan sepenuhnya. Lanjutkan?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Peringatan: Menonaktifkan penegakan tanda tangan driver dan integritas memori, menurunkan keamanan sistem secara drastis.\n\nPerlu mulai ulang agar diterapkan. Lanjutkan?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Peringatan: Mengaktifkan Mode Uji untuk memuat driver tanpa tanda tangan, menurunkan keamanan sistem.\n\nPerlu mulai ulang. Lanjutkan?"

msgid "解除驅動與核心安全限制"
msgstr "Buka Pembatasan Driver & Kernel"

msgid "\n[執行] 正在請求重啟至 BIOS/UEFI...\n"
msgstr "\n[Jalankan] Meminta mulai ulang ke BIOS/UEFI...\n"

