msgstr "  [Kesalahan] Gagal menonaktifkan testsigning: {}\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法開啟記憶體完整性\n"
msgstr "  [Kesalahan] Penulisan registri gagal (kode {}): Tidak dapat mengaktifkan Integritas Memori\n"

msgid "  - 記憶體完整性已開啟\n"
msgstr "  - Integritas Memori diaktifkan\n"

msgid "  - 測試模式已關閉\n"
msgstr "  - Mode Uji dinonaktifkan\n"

msgid "  - 系統安全防護已恢復\n"
msgstr "  - Keamanan sistem dipulihkan\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Kesalahan] Penulisan registri gagal (kode kesalahan {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Peringatan] Terjadi kesalahan. Silakan periksa log di atas.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[Sukses] Keamanan dipulihkan. Mulai ulang agar berlaku.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Jalankan] Membuka pembatasan keamanan driver dan kernel...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Kesalahan] Gagal mengaktifkan nointegritychecks: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Penegakan tanda tangan driver dinonaktifkan\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Kesalahan] Penulisan registri gagal (kode {}): Tidak dapat menonaktifkan Integritas Memori\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Integritas Memori dinonaktifkan\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Kesalahan] Gagal mengaktifkan testsigning: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Mode Uji diaktifkan\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Daftar blokir driver dinonaktifkan\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[Sukses] Pembatasan keamanan dicabut. Mulai ulang agar berlaku.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "Drive/disk USB ditambahkan: {} {}"

msgid "移除了隨身碟/磁碟: {} {}"
