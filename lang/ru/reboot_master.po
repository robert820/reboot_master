msgstr "  - Защита системы восстановлена\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Ошибка] Сбой записи в реестр (код ошибки {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Предупреждение] Произошли ошибки. Проверьте журнал выше.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[Успешно] Защита восстановлена. Перезагрузите компьютер.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Выполнение] Снятие ограничений безопасности драйверов и ядра...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
msgstr "  [Ошибка] Сбой включения nointegritychecks: {}\n"

msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Обязательная проверка подписи драйверов отключена\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Ошибка] Сбой записи в реестр (код {}): не удалось отключить целостность памяти\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Целостность памяти отключена\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Ошибка] Сбой включения testsigning: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Тестовый режим включен\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Список блокировки драйверов отключен\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[Успешно] Ограничения безопасности сняты. Перезагрузите компьютер.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "Подключен USB-накопитель/диск: {} {}"

msgid "移除了隨身碟/磁碟: {} {}"
msgstr "Отключен USB-накопитель/диск: {} {}"

msgid "未偵測到包含 PE 環境的隨身碟"
msgstr "Не найден USB-накопитель со средой PE"

msgid "未插入任何隨身碟"
