msgstr "[{}] Действие: {}\n  Подробности: {}\n  Статус: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "История действий пока пуста.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Не удалось получить привилегию SeShutdownPrivilege"

msgid "關機失敗，錯誤碼: {}"
msgstr "Сбой завершения работы, код ошибки: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Не удалось получить привилегию перезагрузки SeShutdownPrivilege"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Сбой перезагрузки, код ошибки: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "Не удалось получить SeSystemEnvironmentPrivilege. Запустите от имени администратора"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Материнская плата или ОС не поддерживает перезагрузку в настройки BIOS/UEFI"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Не удалось записать переменную UEFI. Блокировано антивирусом или правами доступа."

msgid "重啟至 BIOS/UEFI"
msgstr "Перезагрузка в BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Записана переменная UEFI: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), бит 0 равен 1 (BootToFwUI)"

msgid "準備重啟"
msgstr "Подготовка к перезагрузке"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Переменная UEFI успешно записана. Перезагрузка в BIOS/UEFI..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Ошибка выполнения bcdedit: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "Сбой команды `bcdedit {}`: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Не найден куст реестра SOFTWARE физической системы"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Не удалось найти начало нового GUID в выводе bcdedit"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Не удалось найти конец нового GUID в выводе bcdedit"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Не удалось получить путь к текущему исполняемому файлу: {}"

msgid "一次性安全模式"
msgstr "Однократный безопасный режим"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Режим: {}\n  Временный GUID: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Однократный безопасный режим настроен. Перезагрузка..."

msgid "重啟至進階開機選單"
msgstr "Перезагрузка в особое меню загрузки"

msgid "建立臨時副本 GUID: {}"
msgstr "Создан временный GUID записи: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Однократные особые варианты загрузки настроены. Перезагрузка..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Перезагрузка в прошивку BIOS/UEFI"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Немедленно перезагружает компьютер и автоматически открывает настройки BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Однократный безопасный режим (минимальный)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Однократная загрузка в безопасном режиме. При следующем перезапуске вернется обычный режим."

msgid "一次性安全模式 (含網路)"
msgstr "Однократный безопасный режим (с сетью)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Однократная загрузка в безопасном режиме с сетью. При следующем перезапуске вернется обычный режим."

msgid "重啟進入進階開機選單"
msgstr "Перезагрузка в меню особых вариантов загрузки"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Перезагружает компьютер и открывает меню особых вариантов загрузки и устранения неполадок."

msgid "直接強制重啟電腦"
msgstr "Принудительная перезагрузка"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Немедленно перезагружает компьютер с помощью системного Win32 API."

msgid "直接安全關機"
msgstr "Безопасное завершение работы"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Немедленно выключает компьютер с помощью системного Win32 API."

msgid "開啟測試模式 (Test Mode)"
msgstr "Включить тестовый режим"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Система будет принимать драйверы с тестовой подписью. На рабочем столе появится водяной знак «Тестовый режим».\n\n• Сначала необходимо отключить Secure Boot в BIOS\n• Большинство античитов (EAC, BattlEye) заблокируют запуск игр в этом режиме\n• Требуется перезагрузка. Используйте «Отключить тестовый режим» для выключения"

msgid "關閉測試模式"
msgstr "Отключить тестовый режим"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Отключение тестового режима восстанавливает стандартную проверку подписи драйверов. Требуется перезагрузка."

msgid "停用驅動程式強制簽章"
msgstr "Отключить обязательную проверку подписи драйверов"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Полностью отключает проверку подписей драйверов Windows (nointegritychecks).\n\n• Разрешает установку неподписанных драйверов\n• Безопасность системы значительно снизится\n• Сначала необходимо отключить Secure Boot в BIOS\n• Требуется перезагрузка."

msgid "恢復強制簽章驗證"
msgstr "Восстановить обязательную подпись"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Восстанавливает стандартную проверку цифровых подписей драйверов Windows. Требуется перезагрузка."

msgid "恢復系統安全防護"
msgstr "Восстановить защиту системы"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Восстановит проверку подписей и безопасность ядра Windows по умолчанию.\n\nДля вступления в силу требуется перезагрузка. Продолжить?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Предупреждение: отключает проверку подписей драйверов и целостность памяти, значительно снижая безопасность.\n\nДля вступления в силу требуется перезагрузка. Продолжить?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Предупреждение: включает тестовый режим для загрузки неподписанных драйверов, снижая безопасность.\n\nТребуется перезагрузка. Продолжить?"

msgid "解除驅動與核心安全限制"
msgstr "Снять ограничения драйверов и ядра"

