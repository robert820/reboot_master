msgid "成功建立 PE 啟動項，但發送重啟訊號失敗，請手動重新啟動電腦。"
msgstr "Navnîşa PE hat afirandin, lê sînyala destpêkirinê neçû. Ji kerema xwe bi destan ji nû ve dest pê bike."

msgid "恢復驅動與核心安全防護"
msgstr "Ewlehiya ajoker û navikê vegerîne"

msgid "解除驅動與核心安全限制"
msgstr "Sînorên ewlehiya ajoker û navikê rake"

msgid "包含測試模式、強制簽章與記憶體完整性。\n勾選下方項目並點擊按鈕，設定將於下次重開機後生效。"
msgstr "Moda ceribandinê, zorêdana îmzeyê û yekparebûna bîrê dihewîne.\nVebijarkan hilbijêre û bisepîne. Piştî destpêkirina din çalak dibe."

msgid "停用驅動封鎖規則"
msgstr "Lîsteya astengkirina ajokeran neçalak bike"

msgid "關閉記憶體完整性"
msgstr "Yekparebûna bîrê bigire"

msgid "恢復預設安全"
msgstr "Ewlehiya standard vegerîne"

msgid "套用變更"
msgstr "Guhertinan bisepîne"

msgid "重啟大師 (Reboot Master)"
msgstr "Reboot Master"

msgid "系統就緒。請選擇操作項目。"
msgstr "Pergal amade ye. Çalakiyek hilbijêre."

msgid "USB啟動"
msgstr "Destpêkirina bi USB"

msgid "掃描 USB 裝置中..."
