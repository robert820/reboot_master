msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {})\n"
msgstr "  [Çewtî] Nivîsandina qeydê biserneket (koda çewtiyê {})\n"

msgid "[警告] 過程中有錯誤發生，請檢查上方日誌。\n"
msgstr "[Hişyarî] Çewtî derketin holê. Ji kerema xwe rojnivîska li jor kontrol bike.\n"

msgid "[成功] 安全防護已恢復，請重新開機以生效。\n"
msgstr "[Serkeftî] Ewlehî hat vegerandin. Ji bo sepandinê ji nû ve dest pê bike.\n"

msgid "\n[執行] 正在解除驅動與核心安全限制...\n"
msgstr "\n[Xebitandin] Sînorên ewlehiya ajoker û navikê tên rakirin...\n"

msgid "  [錯誤] 開啟 nointegritychecks 失敗: {}\n"
