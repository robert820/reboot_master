msgid "[{}] 操作: {}\n  變更細節: {}\n  執行狀態: {}\n----------------------------------------\n"
msgstr "[{}] Çalakî: {}\n  Kîtekît: {}\n  Rewş: {}\n----------------------------------------\n"

msgid "尚無歷史操作紀錄。\n"
msgstr "Hêj dîroka çalakiyan tune ye.\n"

msgid "無法獲取 SeShutdownPrivilege 系統關機權限"
msgstr "Destûra pergala SeShutdownPrivilege nehat wergirtin"

msgid "關機失敗，錯誤碼: {}"
msgstr "Girtin biserneket, koda çewtiyê: {}"

msgid "無法獲取 SeShutdownPrivilege 系統重啟權限"
msgstr "Destûra ji nû ve destpêkirina SeShutdownPrivilege nehat wergirtin"

msgid "重啟失敗，錯誤碼: {}"
msgstr "Ji nû ve destpêkirin biserneket, koda çewtiyê: {}"

msgid "無法獲取系統環境權限 (SeSystemEnvironmentPrivilege)，請確認是否以系統管理員身分執行"
msgstr "SeSystemEnvironmentPrivilege nehat wergirtin. Wekî rêveber bidin destpêkirin"

msgid "當前主機板或作業系統不支援直接從系統重啟至韌體/BIOS設定"
msgstr "Karta sereke an pergal piştgiriya ji nû ve destpêkirina rasterast a BIOS/UEFI nake"

msgid "寫入 UEFI 韌體變數失敗，可能受限於防毒軟體或權限異常。"
msgstr "Nivîsandina guhêrbara UEFI biserneket. Ji aliyê antîvîrus an destûran ve hate astengkirin."

msgid "重啟至 BIOS/UEFI"
msgstr "Ji nû ve destpêkirina BIOS/UEFI"

msgid "寫入 UEFI 變數: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C})，Bit 0 設為 1 (BootToFwUI)"
msgstr "Guhêrbara UEFI hat nivîsandin: OsIndications (GUID: {8BE4DF61-93CA-11D2-AA0D-00E098032B8C}), Bîta 0 wekî 1 hat danîn (BootToFwUI)"

msgid "準備重啟"
msgstr "Amadekariya ji nû ve destpêkirinê"

msgid "已成功透過 API 寫入 UEFI 變數，系統正在重新啟動至 BIOS/UEFI..."
msgstr "Guhêrbara UEFI bi serkeftî hat nivîsandin. Ji nû ve di BIOS/UEFI de dest pê dike..."

msgid "執行 bcdedit 失敗: {}"
msgstr "Xebitandina bcdedit biserneket: {}"

msgid "執行 `bcdedit {}` 失敗: {}"
msgstr "`bcdedit {}` biserneket: {}"

msgid "找不到實體系統的 SOFTWARE 登錄檔"
msgstr "Kozika qeydê ya SOFTWARE ya pergala fîzîkî nehat dîtin"

msgid "無法從 bcdedit 輸出中找到新的 GUID 起點"
msgstr "Di derana bcdedit de destpêka GUID-a nû nehat dîtin"

msgid "無法從 bcdedit 輸出中找到新的 GUID 終點"
msgstr "Di derana bcdedit de dawiya GUID-a nû nehat dîtin"

msgid "無法獲取當前執行檔路徑: {}"
msgstr "Rêça dosyeya xebitandinê ya niha nehat wergirtin: {}"

msgid "一次性安全模式"
msgstr "Moda ewle ya yekcarî"

msgid "模式: {}\n  臨時 GUID: {}"
msgstr "Mod: {}\n  GUID ya demkî: {}"

msgid "已成功設定一次性安全模式，系統正在重新啟動..."
msgstr "Moda ewle ya yekcarî hat mîhengkirin. Ji nû ve dest pê dike..."

msgid "重啟至進階開機選單"
msgstr "Ji nû ve di pêşeka destpêkirina pêşketî de bide destpêkirin"

msgid "建立臨時副本 GUID: {}"
msgstr "GUID ya navnîşa demkî hat afirandin: {}"

msgid "已成功設定一次性進階開機選單，系統正在重新啟動..."
msgstr "Vebijarkên destpêkirina pêşketî yên yekcarî hatin mîhengkirin. Ji nû ve dest pê dike..."

msgid "重啟進入 BIOS / UEFI 韌體"
msgstr "Ji nû ve di bellenavê BIOS / UEFI de bide destpêkirin"

msgid "此操作將立即重新啟動電腦並自動進入 BIOS/UEFI 設定畫面。"
msgstr "Komputerê di cih de ji nû ve dide destpêkirin û bixweber dikeve mîhengên BIOS/UEFI."

msgid "一次性安全模式 (Minimal)"
msgstr "Moda ewle ya yekcarî (Kêmîn)"

msgid "下一次開機將進入安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Carekê di moda ewle de dest pê dike. Di destpêkirina din de vedigere moda asayî."

msgid "一次性安全模式 (含網路)"
msgstr "Moda ewle ya yekcarî (bi torê re)"

msgid "下一次開機將進入含網路連線的安全模式。第二次重新開機時，系統將自動恢復進入正常模式。"
msgstr "Carekê di moda ewle bi torê re dest pê dike. Di destpêkirina din de vedigere moda asayî."

msgid "重啟進入進階開機選單"
msgstr "Ji nû ve di vebijarkên destpêkirinê yên pêşketî de bide destpêkirin"

msgid "此操作將重新啟動電腦並直接開啟 Windows 進階開機與疑難排解選單。"
msgstr "Komputerê ji nû ve dide destpêkirin û pêşeka destpêkirina pêşketî û çareserkirina pirsgirêkan vedike."

msgid "直接強制重啟電腦"
msgstr "Bêrawestandin ji nû ve dest pê bike"

msgid "此操作將透過 Win32 原生 API 立即重啟您的電腦。"
msgstr "Komputera we di cih de bi riya Win32 API ya xwemalî ji nû ve dide destpêkirin."

msgid "直接安全關機"
msgstr "Bi ewlehî niha bigire"

msgid "此操作將透過 Win32 原生 API 立即關閉電腦電源。"
msgstr "Elektrîka komputera we di cih de bi riya Win32 API ya xwemalî digire."

msgid "開啟測試模式 (Test Mode)"
msgstr "Moda ceribandinê çalak bike"

msgid "開啟後系統將接受測試簽章驅動程式。桌面右下角會出現「測試模式」浮水印。\n\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 大多數遊戲反作弊（EAC、BattlEye）會拒絕在此模式下運行遊戲\n• 執行後需重新開機才會生效。關閉則執行「關閉測試模式」"
msgstr "Pergal dê ajokerên bi îmzeya ceribandinê qebûl bike. Nîşana avî ya \"Moda ceribandinê\" li ser sermaseyê xuya dibe.\n\n• Divê pêşî Secure Boot di BIOS de were girtin\n• Piraniya pergalên dij-xapandinê (EAC, BattlEye) lîstikan asteng dikin\n• Ji nû ve destpêkirin pêwîst e. Ji bo girtinê \"Moda ceribandinê neçalak bike\" bi kar bîne"

msgid "關閉測試模式"
msgstr "Moda ceribandinê neçalak bike"

msgid "關閉測試模式後，系統將恢復標準驅動簽章驗證。需重新開機才會生效。"
msgstr "Neçalakkirina moda ceribandinê piştrastkirina standard a îmzeya ajokerê vedigerîne. Ji nû ve destpêkirin pêwîst e."

msgid "停用驅動程式強制簽章"
msgstr "Zorêdana îmzeya ajokerê neçalak bike"

msgid "此操作將徹底關閉 Windows 的驅動程式數位簽章驗證 (nointegritychecks)。\n\n• 允許安裝完全沒有數位簽章的驅動程式\n• 系統安全性將大幅降低\n• 需先在 BIOS 關閉 Secure Boot 才能生效\n• 執行後需重新開機才會生效。"
msgstr "Verastkirina îmzeya dîjîtal a ajokerên Windows bi tevahî digire (nointegritychecks).\n\n• Destûrê dide sazkirina ajokerên bê îmze\n• Ewlehiya pergalê dê pir kêm bibe\n• Divê pêşî Secure Boot di BIOS de were girtin\n• Ji nû ve destpêkirin pêwîst e."

msgid "恢復強制簽章驗證"
msgstr "Zorêdana îmzeyê vegerîne"

msgid "將恢復 Windows 預設的驅動程式數位簽章驗證機制。需重新開機才會生效。"
msgstr "Mekanîzmaya standard a piştrastkirina îmzeya ajokerên Windows vedigerîne. Ji nû ve destpêkirin pêwîst e."

msgid "恢復系統安全防護"
msgstr "Ewlehiya pergalê vegerîne"

msgid "將恢復 Windows 預設的數位簽章驗證與核心安全機制。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Ewlehiya navikê û piştrastkirina îmzeya standard a Windows vedigerîne.\n\nJi bo bandora tevahî ji nû ve destpêkirin pêwîst e. Berdewam bike?"

msgid "警告：這將徹底停用驅動程式強制簽章 (nointegritychecks) 並關閉記憶體完整性，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Hişyarî: Zorêdana îmzeya ajokerê û yekparebûna bîrê digire, ku ev ewlehiya pergalê pir kêm dike.\n\nJi nû ve destpêkirin pêwîst e. Berdewam bike?"

msgid "警告：這將開啟測試模式以允許載入未經簽章的驅動程式，大幅降低系統安全性。\n\n需要重新開機才會完全生效。確定要執行嗎？"
msgstr "Hişyarî: Moda ceribandinê çalak dike da ku ajokerên bê îmze werin barkirin, ku ev ewlehiyê kêm dike.\n\nJi nû ve destpêkirin pêwîst e. Berdewam bike?"

msgid "解除驅動與核心安全限制"
msgstr "Sînorên ewlehiya ajoker û navikê rake"

