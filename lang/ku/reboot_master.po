msgid "  - 驅動強制簽章已停用\n"
msgstr "  - Zorêdana îmzeya ajokerê hat neçalakkirin\n"

msgid "  [錯誤] 寫入登錄檔失敗 (錯誤碼 {}): 無法關閉記憶體完整性\n"
msgstr "  [Çewtî] Nivîsandina qeydê biserneket (koda {}): Yekparebûna bîrê nehat girtin\n"

msgid "  - 記憶體完整性已關閉\n"
msgstr "  - Yekparebûna bîrê hat girtin\n"

msgid "  [錯誤] 開啟 testsigning 失敗: {}\n"
msgstr "  [Çewtî] Vekirina testsigning biserneket: {}\n"

msgid "  - 測試模式已開啟\n"
msgstr "  - Moda ceribandinê hat çalakkirin\n"

msgid "  - 驅動封鎖規則已關閉\n"
msgstr "  - Lîsteya astengkirina ajokeran hat girtin\n"

msgid "[成功] 指定的安全限制已解除，請重新開機以生效。\n"
msgstr "[Serkeftî] Sînorên ewlehiyê hatin rakirin. Ji bo sepandinê ji nû ve dest pê bike.\n"

msgid "新增了隨身碟/磁碟: {} {}"
msgstr "Dîska USB hat girêdan: {} {}"

msgid "移除了隨身碟/磁碟: {} {}"
msgstr "Dîska USB hat derxistin: {} {}"

msgid "未偵測到包含 PE 環境的隨身碟"
msgstr "Dîska USB ya bi hawirdora PE nehat tesbîtkirin"

msgid "未插入任何隨身碟"
msgstr "Tu dîska USB nehatiye girêdan"

msgid "USB啟動"
msgstr "Destpêkirina bi USB"

